{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-analysis-new-shell",
    "kind": "incident-analysis-shell",
    "version": "1.0.0",
    "structureMode": "fixed",
    "serviceTiers": [
      {
        "id": "incident-analysis",
        "kind": "incident-analysis"
      },
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [
      {
        "id": "incident-analysis-to-runtime",
        "from": "incident-analysis",
        "to": "runtime-document",
        "implementationPrograms": [
          {
            "id": "reactive",
            "when": "true"
          }
        ],
        "fallback": "reactive"
      }
    ],
    "projectionTiers": [
      {
        "id": "incident-analysis",
        "kind": "incident-analysis",
        "capabilities": [
          "incident-analysis:selection",
          "incident-analysis:source-content",
          "incident-analysis:request",
          "incident-analysis:report"
        ]
      },
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [
      {
        "id": "incident-analysis-to-runtime",
        "from": "incident-analysis",
        "to": "runtime-document",
        "representations": [
          {
            "id": "shared-shell",
            "views": {
              "analysis-params": {
                "primary": {
                  "capability": "primitive:form",
                  "region": "params-form",
                  "props": {
                    "saveLabel": "Select source",
                    "discardLabel": "Discard",
                    "initiallyDirty": true
                  },
                  "before": [
                    {
                      "capability": "fluent:spinner",
                      "props": {
                        "label": "Loading incident reports",
                        "size": "medium"
                      },
                      "visibility": "systemInputs.numSourcesRunning > 0"
                    }
                  ],
                  "bindings": {
                    "fields": {
                      "expression": "{'properties':{'source':{'title':'Source report','type':'string','options':incident.sourceOptions,'placeholder':'Choose a source report','span':12},'model':{'title':'Analysis model','type':'string','options':[{'value':'semantic','label':'Semantic'},{'value':'fixed-presentation','label':'Fixed presentation'},{'value':'refinement','label':'Refinement'}],'span':12}},'required':['source','model']}"
                    },
                    "value": {
                      "from": "incident.selection"
                    }
                  }
                }
              },
              "source-retrieve": {
                "primary": {
                  "capability": "primitive:markdown",
                  "region": "source-content",
                  "bindings": {
                    "value": {
                      "from": "selectedSourceContent"
                    }
                  }
                }
              },
              "incident-analysis": {
                "request": {
                  "capability": "fluent:button",
                  "region": "analysis-report",
                  "props": {
                    "label": "Analyze / refresh report",
                    "appearance": "primary"
                  },
                  "visibility": "systemInputs.numSourcesRunning = 0"
                },
                "progress": {
                  "capability": "fluent:spinner",
                  "region": "analysis-report",
                  "props": {
                    "label": "Analyzing report",
                    "size": "medium"
                  },
                  "visibility": "systemInputs.numSourcesRunning > 0"
                },
                "error": {
                  "capability": "primitive:alert",
                  "region": "analysis-report",
                  "props": {
                    "label": "Analysis failed",
                    "level": "error"
                  },
                  "bindings": {
                    "value": {
                      "expression": "$lookup(systemInputs.sourceErrors, inputs.selectedModel = 'fixed-presentation' ? 'incident-analysis.fixed-presentation-source' : inputs.selectedModel = 'refinement' ? 'incident-analysis.refinement-source' : 'incident-analysis.source').error"
                    }
                  },
                  "visibility": "systemInputs.numSourcesRunning = 0 and $lookup(systemInputs.sourceErrors, inputs.selectedModel = 'fixed-presentation' ? 'incident-analysis.fixed-presentation-source' : inputs.selectedModel = 'refinement' ? 'incident-analysis.refinement-source' : 'incident-analysis.source') != null"
                }
              },
              "report-viewer": {
                "primary": {
                  "capability": "gik:blueprint",
                  "region": "analysis-report",
                  "visibility": "incident.savedReportEnvelope.found and incident.savedReportEnvelope.analysisReport != null",
                  "bindings": {
                    "blueprint": {
                      "expression": "incident.savedReportEnvelope.analysisReport"
                    },
                    "instanceKey": {
                      "expression": "incident.savedReportEnvelope.asOnStamp"
                    }
                  },
                  "before": [
                    {
                      "capability": "fluent:text",
                      "props": {
                        "value": "No analysis report available.",
                        "block": true
                      },
                      "visibility": "incident.savedReportEnvelope = null"
                    },
                    {
                      "capability": "primitive:datetime",
                      "props": {
                        "label": "Analysis as of"
                      },
                      "bindings": {
                        "value": {
                          "expression": "incident.savedReportEnvelope.asOn"
                        }
                      },
                      "visibility": "incident.savedReportEnvelope.asOn != null"
                    }
                  ]
                }
              }
            }
          }
        ],
        "fallback": "shared-shell"
      }
    ],
    "services": {
      "incident-sources": {
        "blueprint": {
          "$ref": "blueprint:incident-analysis-assets@1.0.0"
        },
        "version": "1",
        "operations": {
          "listSourceReports": {
            "operation": "list-sources",
            "contract": "incident-source-list/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "getSourceReport": {
            "operation": "get-source",
            "contract": "incident-source/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'sourceId':input.source_report_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-saved-reports": {
        "blueprint": {
          "$ref": "blueprint:incident-analysis-assets@1.0.0"
        },
        "version": "1",
        "operations": {
          "getSavedReport": {
            "operation": "get-asset",
            "contract": "saved-report-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':input.source_report_key,'analysis_key':input.model}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "putSavedReport": {
            "operation": "put-asset",
            "contract": "saved-report-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':input.source_report_key,'analysis_key':input.model,'saved_report_envelope':{'asOn':input.as_on,'asOnStamp':input.as_on_stamp,'analysisReport':input.analysis_response}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-report-analysis": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReportBlueprint": {
            "operation": "chat",
            "contract": "incident-report-blueprint/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "($mode := input.model; $guidance := $mode = 'refinement' ? 'Preserve every source section, fact, identifier, value, relationship, order, and uncertainty while improving report organization and clarity.' : 'Normalize the supplied incident facts, relationships, evidence, uncertainty, impacts, and actions without inventing content.'; {'message':'Write the incident analysis report from this source report:\\n\\n' & input.incident_report,'instructions':$guidance & ' Return only one JSON object containing the complete report Markdown in the markdown property. Do not construct a Blueprint, service, projection, Cell, or presentation.','agentName':$mode = 'refinement' ? 'Incident-Report-Refinement-Agent' : 'Incident-Report-Semantic-Agent','maxOutputTokens':8000})"
              }
            },
            "response": {
              "transform": {
                "kind": "jsonata",
                "expr": "($markdown := $type(response.markdown) = 'string' ? response.markdown : response.payload.runtime.state.report.markdown; {'gik':'0.1','type':'blueprint','payload':{'id':'generated-incident-report','kind':'semantic-report','version':'1.0.0','structureMode':'fixed','serviceTiers':[{'id':'runtime-document','kind':'runtime-document'}],'serviceRecipes':[],'projectionTiers':[{'id':'report-semantic','kind':'incident-report-semantic-model','capabilities':[]},{'id':'runtime-document','kind':'runtime-document','capabilities':[]}],'projectionRecipes':[{'id':'semantic-report-to-runtime','from':'report-semantic','to':'runtime-document','representations':[{'id':'report','views':{'report':{'primary':{'capability':'primitive:markdown','bindings':{'value':{'from':'report.markdown'}},'region':'report'}}},'presentation':{'slots':['report'],'root':'report'}}],'fallback':'report'}],'runtime':{'externals':{'projectionViews':{'primitive':{'from':'primitive','use':['markdown']}}},'state':{'report':{'markdown':$markdown}}},'cells':{'report':{'id':'report'}},'presentation':{'slots':['report'],'root':'report','allowedCapabilities':['primitive:markdown']}}})"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            },
            "onViolation": {
              "action": "correction-prompt",
              "maxAttempts": 2
            }
          }
        },
        "config": {
          "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
          "credentialRef": "foundry-agent/access-key",
          "responseMode": "json"
        },
        "scope": "per-blueprint"
      },
      "incident-report-fixed-presentation": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "authorReportBlueprint": {
            "operation": "chat",
            "contract": "incident-report-blueprint/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "($instructions := 'Author only the variable report content for the trusted static Blueprint scaffold. The response fragment has exactly two fields: potentialViews and reportState. Treat the supplied source report as the closed factual boundary. Attach one potential view to every required region and use only accepted capabilities. Pass the complete fragment as the fragmentJson string argument to compose_response_validate and compose_response_simulate, correct any reported problem, then call compose_response_set_in_progress_proposal with the final fragmentJson. The host parses, composes, and validates the complete Blueprint; do not return or reproduce the fixed shell.'; $sourceScaffold := input.authoringBrief.blueprintProfile.artifactScaffold; $terminalRuntime := $merge([$sourceScaffold.payload.runtime, {'externals':{'projectionViews':{}},'state':{'report':{}}}]); $terminalPayload := $merge([$sourceScaffold.payload, {'serviceTiers':[{'id':'runtime-document','kind':'runtime-document'}],'serviceRecipes':[],'projectionTiers':[{'id':'runtime-document','kind':'runtime-document','capabilities':[]}],'projectionRecipes':[],'cells':{'report':{'id':'report','potentialViews':{}}},'runtime':$terminalRuntime}]); $terminalScaffold := $merge([$sourceScaffold, {'payload':$terminalPayload}]); $profile := $merge([input.authoringBrief.blueprintProfile, {'artifactScaffold':$terminalScaffold,'responseFragment':{'potentialViews':'<named views attached to required regions>','reportState':'<static source-grounded report state>'},'slotPolicy':'Author only the two response-fragment fields. The host owns and reconstructs the enclosing scaffold.'}]); $brief := $merge([input.authoringBrief, {'constraints':['author exactly potentialViews and reportState','one or more views may reuse an accepted capability when that capability fits the section','every named section region has an attached view','no primitive:markdown'],'blueprintProfile':$profile}]); {'message':'Assignment: ' & $string($brief) & ' Source report: ' & input.incident_report & ' Allowed capabilities: ' & $string(input.acceptedCapabilities),'instructions':$instructions,'agentName':input.agentName,'maxOutputTokens':8000,'presentationMode':input.presentationMode,'acceptedCapabilities':input.acceptedCapabilities,'authoringBrief':$brief,'authoringWorkspace':{'scaffold':$terminalScaffold,'slots':[{'field':'potentialViews','pointer':'/payload/cells/report/potentialViews'},{'field':'reportState','pointer':'/payload/runtime/state/report'}],'capabilityDerivation':{'viewsField':'potentialViews','acceptedCapabilities':input.acceptedCapabilities,'tierPointer':'/payload/projectionTiers/0/capabilities','importsPointer':'/payload/runtime/externals/projectionViews'}}})"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            },
            "onViolation": {
              "action": "correction-prompt",
              "maxAttempts": 2
            }
          }
        },
        "config": {
          "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
          "credentialRef": "foundry-agent/access-key",
          "responseMode": "json"
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": [
              "button",
              "spinner",
              "text"
            ]
          },
          "primitive": {
            "from": "primitive",
            "use": [
              "form",
              "datetime",
              "markdown",
              "alert"
            ]
          }
        }
      },
      "state": {
        "incident": {
          "selection": {
            "source": "",
            "model": "semantic"
          },
          "sourceOptions": [],
          "refresherStamp": 0,
          "savedReportEnvelope": null
        }
      }
    },
    "cells": {
      "analysis-params": {
        "id": "analysis-params",
        "systemInputs": [
          "numSourcesRunning"
        ],
        "sources": [
          {
            "id": "analysis-params.source",
            "service": "incident-sources",
            "operation": "listSourceReports",
            "when": "true",
            "output": {
              "kind": "jsonata",
              "expr": "response.sources"
            }
          }
        ],
        "compute": [
          {
            "id": "source-options",
            "expression": "$exists(sources.`analysis-params.source`) ? sources.`analysis-params.source`.{'value':id,'label':label} : []",
            "assign": "incident.sourceOptions",
            "dependencies": [
              "sources.analysis-params.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "selected-source",
            "from": "incident.selection.source"
          },
          {
            "token": "selected-model",
            "from": "incident.selection.model"
          }
        ],
        "behavior": {
          "on": {
            "save": [
              {
                "do": "assign",
                "target": "incident.selection",
                "args": {
                  "from": "$event.values"
                }
              },
              {
                "do": "assign",
                "target": "incident.refresherStamp",
                "args": {
                  "value": 0
                }
              }
            ]
          }
        },
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:selection",
            "region": "params-form",
            "props": {
              "saveLabel": "Select source",
              "discardLabel": "Discard",
              "initiallyDirty": true
            },
            "before": [
              {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Loading incident reports",
                  "size": "medium"
                },
                "visibility": "systemInputs.numSourcesRunning > 0"
              }
            ],
            "bindings": {
              "fields": {
                "expression": "{'properties':{'source':{'title':'Source report','type':'string','options':incident.sourceOptions,'placeholder':'Choose a source report','span':12},'model':{'title':'Analysis model','type':'string','options':[{'value':'semantic','label':'Semantic'},{'value':'fixed-presentation','label':'Fixed presentation'},{'value':'refinement','label':'Refinement'}],'span':12}},'required':['source','model']}"
              },
              "value": {
                "from": "incident.selection"
              }
            }
          }
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "source-retrieve": {
        "id": "source-retrieve",
        "inputs": [
          {
            "token": "selected-source",
            "as": "selectedSource",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "source-retrieve.source",
            "service": "incident-sources",
            "operation": "getSourceReport",
            "when": "$type(inputs.selectedSource) = 'string' and inputs.selectedSource != ''",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedSource}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response.content"
            }
          }
        ],
        "compute": [
          {
            "id": "selected-source-content",
            "expression": "sources.`source-retrieve.source`",
            "assign": "selectedSourceContent",
            "dependencies": [
              "sources.source-retrieve.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "selected-source-content",
            "from": "computed.selectedSourceContent",
            "when": "$type(computed.selectedSourceContent) = 'string' and computed.selectedSourceContent != ''"
          }
        ],
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:source-content",
            "region": "source-content",
            "bindings": {
              "value": {
                "from": "selectedSourceContent"
              }
            }
          }
        }
      },
      "cache-envelope-retrieve": {
        "id": "cache-envelope-retrieve",
        "inputs": [
          {
            "token": "selected-source",
            "as": "selectedSource",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "incident.refresherStamp",
            "as": "refresherStamp"
          }
        ],
        "sources": [
          {
            "id": "cache-envelope-retrieve.source",
            "service": "incident-saved-reports",
            "operation": "getSavedReport",
            "when": "$type(inputs.selectedSource) = 'string' and inputs.selectedSource != '' and $type(inputs.selectedModel) = 'string' and inputs.selectedModel != ''",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedSource,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'found':response != null,'analysisReport':response ? response.analysisReport : null,'asOn':response ? response.asOn : null,'asOnStamp':response ? response.asOnStamp : null}"
            }
          }
        ],
        "compute": [
          {
            "id": "saved-report-envelope",
            "expression": "sources.`cache-envelope-retrieve.source`",
            "assign": "savedReportEnvelope",
            "dependencies": [
              "sources.cache-envelope-retrieve.source"
            ]
          },
          {
            "id": "saved-refresher-stamp",
            "expression": "inputs.refresherStamp != null ? inputs.refresherStamp : 0",
            "assign": "savedRefresherStamp",
            "dependencies": [
              "inputs.refresherStamp",
              "sources.cache-envelope-retrieve.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "saved-report-envelope",
            "from": "computed.savedReportEnvelope"
          },
          {
            "token": "saved-refresher-stamp",
            "from": "computed.savedRefresherStamp",
            "when": "computed.savedRefresherStamp != null"
          }
        ],
        "potentialViews": {}
      },
      "incident-analysis": {
        "id": "incident-analysis",
        "systemInputs": [
          "numSourcesRunning",
          "sourceErrors"
        ],
        "inputs": [
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "selected-source-content",
            "as": "selectedSourceContent",
            "required": true
          },
          {
            "token": "saved-refresher-stamp",
            "as": "savedRefresherStamp",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "incident-analysis.source",
            "service": "incident-report-analysis",
            "operation": "analyzeReportBlueprint",
            "when": "inputs.savedRefresherStamp != 0 and inputs.selectedModel = 'semantic'",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.selectedSourceContent,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'analysisResponse':response,'asOn':$now()}"
            },
            "acceptanceCriteria": [
              {
                "kind": "blueprint",
                "code": "incident-report-blueprint",
                "message": "Incident analysis source did not produce a valid Blueprint"
              },
              {
                "kind": "jsonata",
                "expr": "$type(data.payload.runtime.state.report.markdown) = 'string' and $length(data.payload.runtime.state.report.markdown) > 0",
                "code": "incident-report-markdown",
                "message": "Incident analysis source produced an empty report"
              }
            ]
          },
          {
            "id": "incident-analysis.fixed-presentation-source",
            "service": "incident-report-fixed-presentation",
            "operation": "authorReportBlueprint",
            "when": "inputs.savedRefresherStamp != 0 and inputs.selectedModel = 'fixed-presentation'",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.selectedSourceContent,'model':inputs.selectedModel,'agentName':'Incident-Report-Fixed-Presentation-Agent','presentationMode':'fixed-presentation','acceptedCapabilities':['semantic:decision','semantic:narrative','security:attack-path','semantic:event-series','semantic:entity-set','semantic:evidence-case'],'instructions':'Author a complete source-grounded static report Blueprint with the supplied fixed presentation. Treat the supplied source report as the closed factual boundary. Use exactly one inert Cell with id report. Put every report projection view under views.report in one projection representation and attach each view to one supplied named section region. Use only accepted capabilities. Do not add services, Cell sources, inputs, outputs, compute, behavior, events, or executable data flow. Preserve the scaffold identity, fixed presentation slots, and one-Cell shape. Return only the complete Blueprint JSON.','authoringBrief':{'objective':'Render the supplied incident report as a source-grounded static report Blueprint using the fixed presentation without inferring facts, causality, compromise status, severity, urgency, attribution, or recommendations.','presentation':{'root':'report','sectionRegions':['header','verdict','summary','attack-graph','correlated-alerts','timeline','compromised-entities','ttps-and-key-activities','iocs','recommended-actions'],'sectionGuidance':{'header':'Incident identity and report orientation.','verdict':'Source-stated classification, determination, and confidence.','summary':'Concise source-grounded incident summary.','attack-graph':'Directed entities and relationships explicitly supported by the source.','correlated-alerts':'Source-listed alerts and their evidence.','timeline':'Chronological source events.','compromised-entities':'Affected, targeted, compromised, and observed entities using only source-stated status.','ttps-and-key-activities':'Source-listed techniques, tactics, and key activities.','iocs':'Source-listed indicators of compromise.','recommended-actions':'Only actions explicitly recommended by the source.'}},'constraints':['exactly one Cell named report','all projection views belong to the report Cell','one or more views may reuse an accepted capability when that capability fits the section','every named section region has an attached view','no primitive:markdown','no services or executable data flow'],'blueprintProfile':{'artifactScaffold':{'gik':'0.1','type':'blueprint','payload':{'id':'generated-incident-report','kind':'semantic-report','version':'1.0.0','structureMode':'fixed','serviceTiers':[{'id':'runtime-document','kind':'runtime-document'}],'serviceRecipes':[],'projectionTiers':[{'id':'report-semantic','kind':'incident-report-semantic-model','capabilities':[]},{'id':'runtime-document','kind':'runtime-document','capabilities':[]}],'projectionRecipes':[{'id':'semantic-report-to-runtime','from':'report-semantic','to':'runtime-document','representations':[{'id':'report','views':{'report':'<replace with named projection views attached to the fixed section regions>'},'presentation':{'slots':['report',{'id':'header','region':'report'},{'id':'verdict','region':'report'},{'id':'summary','region':'report'},{'id':'attack-graph','region':'report'},{'id':'correlated-alerts','region':'report'},{'id':'timeline','region':'report'},{'id':'compromised-entities','region':'report'},{'id':'ttps-and-key-activities','region':'report'},{'id':'iocs','region':'report'},{'id':'recommended-actions','region':'report'}],'root':'report'}}],'fallback':'report'}],'cells':{'report':{'id':'report'}},'runtime':{'externals':{'projectionViews':'<replace with imports matching capabilities used>'},'state':{'report':'<replace with static source-grounded report data>'}},'presentation':{'slots':['report',{'id':'header','region':'report'},{'id':'verdict','region':'report'},{'id':'summary','region':'report'},{'id':'attack-graph','region':'report'},{'id':'correlated-alerts','region':'report'},{'id':'timeline','region':'report'},{'id':'compromised-entities','region':'report'},{'id':'ttps-and-key-activities','region':'report'},{'id':'iocs','region':'report'},{'id':'recommended-actions','region':'report'}],'root':'report','allowedCapabilities':['semantic:decision','semantic:narrative','security:attack-path','semantic:event-series','semantic:entity-set','semantic:evidence-case']}}},'slotPolicy':'Replace every angle-bracket slot with a valid artifact fragment; preserve the enclosing scaffold, fixed section slots, and one-Cell shape.','presentation':{'root':'report','sectionRegions':['header','verdict','summary','attack-graph','correlated-alerts','timeline','compromised-entities','ttps-and-key-activities','iocs','recommended-actions']},'behavior':'inert'}}}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'analysisResponse':response,'asOn':$now()}"
            },
            "acceptanceCriteria": [
              {
                "kind": "blueprint",
                "code": "incident-report-blueprint",
                "message": "Fixed-presentation analysis did not produce a valid Blueprint"
              },
              {
                "kind": "blueprint-capability-acceptance",
                "code": "incident-report-capability-acceptance",
                "message": "Fixed-presentation report uses a capability outside its accepted set"
              },
              {
                "kind": "jsonata",
                "expr": "$count(data.payload.serviceTiers) = 1 and data.payload.serviceTiers[0].id = 'runtime-document' and $count(data.payload.projectionTiers) = 1 and data.payload.projectionTiers[0].id = 'runtime-document' and $count(data.payload.serviceRecipes) = 0 and $count(data.payload.projectionRecipes) = 0",
                "code": "incident-report-projection-capability-ownership",
                "message": "Fixed-presentation report must be terminal with one runtime-document tier per axis and no lowering recipes"
              },
              {
                "kind": "jsonata",
                "expr": "($required := $request.authoringBrief.blueprintProfile.presentation.sectionRegions; $cells := data.payload.cells; $cell := $cells.report; $views := $cell.potentialViews; $regions := $views.*.region; $slotIds := data.payload.presentation.slots.($exists(id) ? id : $); $count($keys($cells)) = 1 and $cell.id = 'report' and $not($exists($cell.sources)) and $not($exists($cell.inputs)) and $not($exists($cell.outputs)) and $not($exists($cell.compute)) and $not($exists($cell.behavior)) and $not($exists($cell.events)) and ($not($exists(data.payload.services)) or $count($keys(data.payload.services)) = 0) and $count($regions) = $count($required) and $count($required[$not($ in $regions)]) = 0 and $count($regions[$not($ in $required)]) = 0 and $count($required[$not($ in $slotIds)]) = 0)",
                "code": "incident-report-fixed-presentation-shape",
                "message": "Fixed-presentation report must be one inert report Cell with one view attached to every required section region"
              }
            ]
          },
          {
            "id": "incident-analysis.refinement-source",
            "service": "incident-report-analysis",
            "operation": "analyzeReportBlueprint",
            "when": "inputs.savedRefresherStamp != 0 and inputs.selectedModel = 'refinement'",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.selectedSourceContent,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'analysisResponse':response,'asOn':$now()}"
            },
            "acceptanceCriteria": [
              {
                "kind": "blueprint",
                "code": "incident-report-blueprint",
                "message": "Incident analysis source did not produce a valid Blueprint"
              },
              {
                "kind": "jsonata",
                "expr": "$type(data.payload.runtime.state.report.markdown) = 'string' and $length(data.payload.runtime.state.report.markdown) > 0",
                "code": "incident-report-markdown",
                "message": "Incident analysis source produced an empty report"
              }
            ]
          }
        ],
        "compute": [
          {
            "id": "analysis-result",
            "expression": "$exists(sources.`incident-analysis.refinement-source`) ? sources.`incident-analysis.refinement-source` : ($exists(sources.`incident-analysis.fixed-presentation-source`) ? sources.`incident-analysis.fixed-presentation-source` : sources.`incident-analysis.source`)",
            "assign": "analysisResult",
            "dependencies": [
              "sources.incident-analysis.source",
              "sources.incident-analysis.fixed-presentation-source",
              "sources.incident-analysis.refinement-source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "analysis-response",
            "from": "computed.analysisResult.analysisResponse",
            "when": "computed.analysisResult.analysisResponse != null"
          },
          {
            "token": "asOn",
            "from": "computed.analysisResult.asOn",
            "when": "computed.analysisResult.asOn != null"
          },
          {
            "token": "asOnStamp",
            "from": "inputs.savedRefresherStamp",
            "when": "computed.analysisResult.analysisResponse != null and inputs.savedRefresherStamp != null"
          }
        ],
        "behavior": {
          "on": {
            "press": [
              {
                "do": "assign",
                "target": "incident.refresherStamp",
                "args": {
                  "from": "$number(incident.refresherStamp) + 1"
                }
              }
            ]
          }
        },
        "potentialViews": {
          "request": {
            "capability": "incident-analysis:request",
            "region": "analysis-report",
            "props": {
              "label": "Analyze / refresh report",
              "appearance": "primary"
            },
            "visibility": "systemInputs.numSourcesRunning = 0"
          },
          "progress": {
            "capability": "fluent:spinner",
            "region": "analysis-report",
            "props": {
              "label": "Analyzing report",
              "size": "medium"
            },
            "visibility": "systemInputs.numSourcesRunning > 0"
          },
          "error": {
            "capability": "primitive:alert",
            "region": "analysis-report",
            "props": {
              "label": "Analysis failed",
              "level": "error"
            },
            "bindings": {
              "value": {
                "expression": "$lookup(systemInputs.sourceErrors, inputs.selectedModel = 'fixed-presentation' ? 'incident-analysis.fixed-presentation-source' : inputs.selectedModel = 'refinement' ? 'incident-analysis.refinement-source' : 'incident-analysis.source').error"
              }
            },
            "visibility": "systemInputs.numSourcesRunning = 0 and $lookup(systemInputs.sourceErrors, inputs.selectedModel = 'fixed-presentation' ? 'incident-analysis.fixed-presentation-source' : inputs.selectedModel = 'refinement' ? 'incident-analysis.refinement-source' : 'incident-analysis.source') != null"
          }
        },
        "events": {
          "press": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "cache-envelope-update": {
        "id": "cache-envelope-update",
        "inputs": [
          {
            "token": "selected-source",
            "as": "selectedSource",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "analysis-response",
            "as": "analysisResponse",
            "required": true
          },
          {
            "token": "asOn",
            "as": "asOn",
            "required": true
          },
          {
            "token": "asOnStamp",
            "as": "asOnStamp",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "cache-envelope-update.source",
            "service": "incident-saved-reports",
            "operation": "putSavedReport",
            "when": "inputs.analysisResponse != null and inputs.asOn != null and inputs.asOnStamp != null",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedSource,'model':inputs.selectedModel,'analysis_response':inputs.analysisResponse,'as_on':inputs.asOn,'as_on_stamp':inputs.asOnStamp}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'found':response != null,'analysisReport':response ? response.analysisReport : null,'asOn':response ? response.asOn : null,'asOnStamp':response ? response.asOnStamp : null}"
            }
          }
        ],
        "compute": [
          {
            "id": "saved-report-envelope",
            "expression": "sources.`cache-envelope-update.source`",
            "assign": "savedReportEnvelope",
            "dependencies": [
              "sources.cache-envelope-update.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "saved-report-envelope",
            "from": "computed.savedReportEnvelope",
            "when": "computed.savedReportEnvelope != null"
          }
        ]
      },
      "report-viewer": {
        "id": "report-viewer",
        "inputs": [
          {
            "token": "saved-report-envelope",
            "as": "savedReportEnvelope"
          }
        ],
        "compute": [
          {
            "id": "saved-report-envelope",
            "expression": "inputs.savedReportEnvelope",
            "assign": "incident.savedReportEnvelope",
            "dependencies": [
              "inputs.savedReportEnvelope"
            ]
          }
        ],
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:report",
            "region": "analysis-report",
            "visibility": "incident.savedReportEnvelope.found and incident.savedReportEnvelope.analysisReport != null",
            "bindings": {
              "blueprint": {
                "expression": "incident.savedReportEnvelope.analysisReport"
              },
              "instanceKey": {
                "expression": "incident.savedReportEnvelope.asOnStamp"
              }
            },
            "before": [
              {
                "capability": "fluent:text",
                "props": {
                  "value": "No analysis report available.",
                  "block": true
                },
                "visibility": "incident.savedReportEnvelope = null"
              },
              {
                "capability": "primitive:datetime",
                "props": {
                  "label": "Analysis as of"
                },
                "bindings": {
                  "value": {
                    "expression": "incident.savedReportEnvelope.asOn"
                  }
                },
                "visibility": "incident.savedReportEnvelope.asOn != null"
              }
            ]
          }
        }
      }
    },
    "presentation": {
      "slots": [
        "shell",
        {
          "id": "params-form",
          "region": "shell"
        },
        {
          "id": "content",
          "region": "shell"
        },
        {
          "id": "source-content",
          "region": "content"
        },
        {
          "id": "analysis-report",
          "region": "content"
        }
      ],
      "root": "shell",
      "layout": {
        "shell": {
          "direction": "column",
          "gap": "l"
        },
        "content": {
          "gap": "l",
          "align": "stretch"
        },
        "source-content": {
          "direction": "column",
          "gap": "m"
        },
        "analysis-report": {
          "direction": "column",
          "gap": "m"
        }
      },
      "allowedCapabilities": [
        {
          "tier": "incident-analysis"
        },
        "fluent:button",
        "fluent:spinner",
        "fluent:text",
        "gik:blueprint",
        "primitive:datetime",
        "primitive:alert",
        "primitive:form",
        "primitive:markdown"
      ]
    },
    "metadata": {
      "compositionPattern": "reactive-source-analysis-with-durable-report"
    }
  }
}
