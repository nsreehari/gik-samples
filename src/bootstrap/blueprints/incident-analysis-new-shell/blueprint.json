{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-analysis-new-shell",
    "kind": "incident-analysis-shell",
    "version": "1.0.0",
    "structureMode": "fixed",
    "contextFormSpec": {
      "fields": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "title": "Analysis model",
            "enum": [
              "semantic",
              "source-faithful",
              "refinement"
            ],
            "enumNames": [
              "Semantic",
              "Source faithful",
              "Refinement"
            ]
          }
        },
        "required": [
          "model"
        ],
        "additionalProperties": true
      },
      "initialValue": {
        "model": "semantic"
      },
      "saveLabel": "Apply context",
      "discardLabel": "Discard"
    },
    "serviceTiers": [
      {
        "id": "incident-analysis",
        "kind": "incident-analysis"
      },
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [
      {
        "id": "incident-analysis-to-runtime",
        "from": "incident-analysis",
        "to": "runtime-document",
        "implementationPrograms": [
          {
            "id": "semantic",
            "when": "externalContext.model = 'semantic'"
          },
          {
            "id": "source-faithful",
            "when": "externalContext.model = 'source-faithful'",
            "cells": {
              "analysis-selection": {
                "compute": [
                  {
                    "id": "selected-model",
                    "expression": "'source-faithful'",
                    "assign": "model"
                  }
                ]
              }
            }
          },
          {
            "id": "refinement",
            "when": "externalContext.model = 'refinement'",
            "cells": {
              "analysis-selection": {
                "compute": [
                  {
                    "id": "selected-model",
                    "expression": "'refinement'",
                    "assign": "model"
                  }
                ]
              },
              "report-analysis": {
                "sources": [
                  {
                    "id": "report-analysis.source",
                    "service": "incident-report-refinement",
                    "operation": "analyzeReportBlueprint",
                    "when": "inputs.analysisRequest.selectedReport = inputs.selectedReport and inputs.analysisRequest.selectedModel = inputs.selectedModel",
                    "input": {
                      "kind": "jsonata",
                      "expr": "{'incident_report':inputs.reportContent,'model':inputs.selectedModel}"
                    },
                    "output": {
                      "kind": "jsonata",
                      "expr": "response"
                    }
                  }
                ]
              }
            }
          }
        ],
        "fallback": "semantic"
      }
    ],
    "projectionTiers": [
      {
        "id": "incident-analysis",
        "kind": "incident-analysis",
        "capabilities": [
          "incident-analysis:selection",
          "incident-analysis:request",
          "incident-analysis:report"
        ]
      },
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [
      {
        "id": "incident-analysis-to-runtime",
        "from": "incident-analysis",
        "to": "runtime-document",
        "representations": [
          {
            "id": "shared-shell",
            "views": {
              "analysis-selection": {
                "primary": {
                  "capability": "primitive:form",
                  "region": "shell",
                  "props": {
                    "saveLabel": "Select report",
                    "discardLabel": "Discard",
                    "initiallyDirty": true
                  },
                  "before": [
                    {
                      "capability": "fluent:spinner",
                      "props": {
                        "label": "Loading incident reports",
                        "size": "medium"
                      },
                      "visibility": "systemInputs.numSourcesRunning > 0"
                    }
                  ],
                  "bindings": {
                    "fields": {
                      "expression": "{'properties':{'sourceReport':{'title':'Source report','type':'string','options':incident.sourceOptions,'placeholder':'Choose a source report','span':12}},'required':['sourceReport']}"
                    },
                    "value": {
                      "from": "incident.selection"
                    }
                  },
                  "visibility": "$count(incident.sourceOptions) > 0"
                }
              },
              "report-analysis": {
                "primary": {
                  "capability": "fluent:button",
                  "region": "shell",
                  "props": {
                    "label": "Analyze / refresh report",
                    "appearance": "primary"
                  },
                  "before": [
                    {
                      "capability": "fluent:spinner",
                      "props": {
                        "label": "Analyzing report",
                        "size": "medium"
                      },
                      "visibility": "systemInputs.numSourcesRunning > 0"
                    }
                  ]
                }
              },
              "report-resolution": {
                "primary": {
                  "capability": "gik:blueprint",
                  "region": "shell",
                  "visibility": "incident.resolvedSavedReportEnvelope.found and incident.resolvedSavedReportEnvelope.analysisReport != null",
                  "bindings": {
                    "blueprint": {
                      "expression": "incident.resolvedSavedReportEnvelope.analysisReport"
                    }
                  },
                  "before": [
                    {
                      "capability": "primitive:datetime",
                      "props": {
                        "label": "Analysis as of"
                      },
                      "bindings": {
                        "value": {
                          "expression": "incident.resolvedSavedReportEnvelope.asOn"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ],
        "fallback": "shared-shell"
      }
    ],
    "services": {
      "incident-sources": {
        "blueprint": {
          "$ref": "blueprint:incident-analysis-assets@1.0.0"
        },
        "version": "1",
        "operations": {
          "listSourceReports": {
            "operation": "list-sources",
            "contract": "incident-source-list/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "getSourceReport": {
            "operation": "get-source",
            "contract": "incident-source/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'sourceId':input.source_report_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-saved-reports": {
        "blueprint": {
          "$ref": "blueprint:incident-analysis-assets@1.0.0"
        },
        "version": "1",
        "operations": {
          "getSavedReport": {
            "operation": "get-asset",
            "contract": "saved-report-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':input.source_report_key,'analysis_key':input.model}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "putSavedReport": {
            "operation": "put-asset",
            "contract": "saved-report-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':input.source_report_key,'analysis_key':input.model,'saved_report_envelope':{'asOn':$now(),'analysisReport':input.analysis_report}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-report-analysis": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReportBlueprint": {
            "operation": "chat",
            "contract": "incident-report-blueprint/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "($mode := input.model; $guidance := $mode = 'refinement' ? 'Preserve every source section, fact, identifier, value, relationship, order, and uncertainty while improving report organization and clarity.' : ($mode = 'source-faithful' ? 'Preserve only facts, relationships, verdicts, impacts, priorities, actions, ordering, identifiers, evidence, and uncertainty explicitly asserted by the source. Do not infer causality, compromise status, severity, urgency, attribution, or recommendations.' : 'Normalize the supplied incident facts, relationships, evidence, uncertainty, impacts, and actions without inventing content.'); {'message':'Create a self-contained GIK incident analysis report Blueprint from this source report:\n\n' & input.incident_report,'instructions':'Return the complete Blueprint artifact directly. ' & $guidance & ' Put the complete report in payload.runtime.state.report.markdown. Use exactly the schema-authored terminal service tier with no service recipes, two projection tiers with one projection recipe, primitive:markdown catalog, runtime state, and report Cell. Do not add services, effects, native code, references, controls, host mutation instructions, or projection alternatives.','maxOutputTokens':8000})"
              }
            },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident report Blueprint is invalid",
                  "schema": {
                    "type": "object",
                    "required": [
                      "gik",
                      "type",
                      "payload"
                    ],
                    "properties": {
                      "gik": {
                        "type": "string",
                        "const": "0.1"
                      },
                      "type": {
                        "type": "string",
                        "const": "blueprint"
                      },
                      "payload": {
                        "type": "object",
                        "required": [
                          "id",
                          "kind",
                          "version",
                          "structureMode",
                          "serviceTiers",
                          "serviceRecipes",
                          "projectionTiers",
                          "projectionRecipes",
                          "runtime",
                          "cells"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "const": "generated-incident-report"
                          },
                          "kind": {
                            "type": "string",
                            "const": "semantic-report"
                          },
                          "version": {
                            "type": "string",
                            "const": "1.0.0"
                          },
                          "structureMode": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "serviceTiers": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 1,
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "kind"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "kind": {
                                  "type": "string"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "serviceRecipes": {
                            "type": "array",
                            "maxItems": 0,
                            "items": {
                              "type": "object",
                              "required": [],
                              "properties": {},
                              "additionalProperties": false
                            }
                          },
                          "projectionTiers": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "kind"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "kind": {
                                  "type": "string"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "projectionRecipes": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 1,
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "from",
                                "to",
                                "representations",
                                "fallback"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "const": "semantic-report-to-runtime"
                                },
                                "from": {
                                  "type": "string",
                                  "const": "report-semantic"
                                },
                                "to": {
                                  "type": "string",
                                  "const": "runtime-document"
                                },
                                "representations": {
                                  "type": "array",
                                  "minItems": 1,
                                  "maxItems": 1,
                                  "items": {
                                    "type": "object",
                                    "required": [
                                      "id",
                                      "views",
                                      "presentation"
                                    ],
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "const": "report"
                                      },
                                      "views": {
                                        "type": "object",
                                        "required": [
                                          "report"
                                        ],
                                        "properties": {
                                          "report": {
                                            "type": "object",
                                            "required": [
                                              "capability",
                                              "bindings"
                                            ],
                                            "properties": {
                                              "capability": {
                                                "type": "string",
                                                "const": "primitive:markdown"
                                              },
                                              "bindings": {
                                                "type": "object",
                                                "required": [
                                                  "value"
                                                ],
                                                "properties": {
                                                  "value": {
                                                    "type": "object",
                                                    "required": [
                                                      "from"
                                                    ],
                                                    "properties": {
                                                      "from": {
                                                        "type": "string",
                                                        "const": "report.markdown"
                                                      }
                                                    },
                                                    "additionalProperties": false
                                                  }
                                                },
                                                "additionalProperties": false
                                              }
                                            },
                                            "additionalProperties": false
                                          }
                                        },
                                        "additionalProperties": false
                                      },
                                      "presentation": {
                                        "type": "object",
                                        "required": [
                                          "roots",
                                          "composition"
                                        ],
                                        "properties": {
                                          "roots": {
                                            "type": "array",
                                            "minItems": 1,
                                            "maxItems": 1,
                                            "items": {
                                              "type": "string",
                                              "const": "report"
                                            }
                                          },
                                          "composition": {
                                            "type": "object",
                                            "required": [],
                                            "properties": {},
                                            "additionalProperties": false
                                          }
                                        },
                                        "additionalProperties": false
                                      }
                                    },
                                    "additionalProperties": false
                                  }
                                },
                                "fallback": {
                                  "type": "string",
                                  "const": "report"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "runtime": {
                            "type": "object",
                            "required": [
                              "expression",
                              "namespaces",
                              "actions",
                              "capabilities",
                              "externals",
                              "state"
                            ],
                            "properties": {
                              "expression": {
                                "type": "string",
                                "const": "jsonata"
                              },
                              "namespaces": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 1,
                                "items": {
                                  "type": "string",
                                  "const": "report"
                                }
                              },
                              "actions": {
                                "type": "array",
                                "maxItems": 0,
                                "items": {
                                  "type": "string"
                                }
                              },
                              "capabilities": {
                                "type": "object",
                                "required": [
                                  "primitive:markdown"
                                ],
                                "properties": {
                                  "primitive:markdown": {
                                    "type": "object",
                                    "required": [
                                      "propsSchema"
                                    ],
                                    "properties": {
                                      "propsSchema": {
                                        "type": "object",
                                        "required": [
                                          "type",
                                          "additionalProperties"
                                        ],
                                        "properties": {
                                          "type": {
                                            "type": "string",
                                            "const": "object"
                                          },
                                          "additionalProperties": {
                                            "type": "boolean",
                                            "const": true
                                          }
                                        },
                                        "additionalProperties": false
                                      }
                                    },
                                    "additionalProperties": false
                                  }
                                },
                                "additionalProperties": false
                              },
                              "externals": {
                                "type": "object",
                                "required": [
                                  "projectionViews"
                                ],
                                "properties": {
                                  "projectionViews": {
                                    "type": "object",
                                    "required": [
                                      "primitive"
                                    ],
                                    "properties": {
                                      "primitive": {
                                        "type": "object",
                                        "required": [
                                          "from",
                                          "use"
                                        ],
                                        "properties": {
                                          "from": {
                                            "type": "string",
                                            "const": "primitive"
                                          },
                                          "use": {
                                            "type": "array",
                                            "minItems": 1,
                                            "maxItems": 1,
                                            "items": {
                                              "type": "string",
                                              "const": "markdown"
                                            }
                                          }
                                        },
                                        "additionalProperties": false
                                      }
                                    },
                                    "additionalProperties": false
                                  }
                                },
                                "additionalProperties": false
                              },
                                "state": {
                                  "type": "object",
                                  "required": [
                                    "report"
                                  ],
                                  "properties": {
                                    "report": {
                                      "type": "object",
                                      "required": [
                                        "markdown"
                                      ],
                                      "properties": {
                                        "markdown": {
                                          "type": "string",
                                          "minLength": 1
                                        }
                                      },
                                      "additionalProperties": false
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              },
                              "additionalProperties": false
                            },
                            "cells": {
                              "type": "object",
                              "required": [
                                "report"
                              ],
                              "properties": {
                                "report": {
                                  "type": "object",
                                  "required": [
                                    "id",
                                    "kind"
                                  ],
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "const": "report"
                                    },
                                    "kind": {
                                      "type": "string",
                                      "const": "semantic-report"
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                {
                  "kind": "jsonata",
                  "expr": "data.payload.projectionTiers[0].id = 'report-semantic' and data.payload.projectionTiers[0].kind = 'incident-report-semantic-model' and data.payload.projectionTiers[1].id = 'runtime-document' and data.payload.projectionTiers[1].kind = 'runtime-document'",
                  "message": "Incident report Blueprint must contain semantic and runtime-document projection tiers",
                  "code": "report-blueprint-projection-tiers"
                }
              ]
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            },
            "onViolation": {
              "action": "fail"
            }
          }
        },
        "config": {
          "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
          "agent": "Incident-Report-Semantic-Agent",
          "credentialRef": "foundry-agent/access-key"
        },
        "scope": "per-blueprint"
      },
      "incident-report-refinement": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReportBlueprint": {
            "operation": "chat",
            "contract": "incident-report-blueprint/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'message':'Create a self-contained GIK incident analysis report Blueprint from this source report:\\n\\n' & input.incident_report,'instructions':'Return the complete Blueprint artifact directly. Preserve every source section, fact, identifier, value, relationship, order, and uncertainty while improving report organization and clarity. Put the complete report in payload.runtime.state.report.markdown. Use exactly the schema-authored terminal service tier with no service recipes, two projection tiers with one projection recipe, primitive:markdown catalog, runtime state, and report Cell. Do not add services, effects, native code, references, controls, host mutation instructions, or projection alternatives.','maxOutputTokens':8000}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            },
            "onViolation": {
              "action": "fail"
            }
          }
        },
        "config": {
          "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
          "agent": "Incident-Report-Refinement-Agent",
          "credentialRef": "foundry-agent/access-key"
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": [
              "button",
              "spinner"
            ]
          },
          "primitive": {
            "from": "primitive",
            "use": [
              "form",
              "datetime"
            ]
          }
        }
      },
      "state": {
        "incident": {
          "selection": {
            "sourceReport": ""
          },
          "analysisRequest": null,
          "sourceOptions": [],
          "resolvedSavedReportEnvelope": null
        }
      }
    },
    "cells": {
      "analysis-selection": {
        "id": "analysis-selection",
        "systemInputs": [
          "numSourcesRunning"
        ],
        "inputs": [
          {
            "token": "incident.selection",
            "as": "selection"
          }
        ],
        "sources": [
          {
            "id": "analysis-selection.source",
            "service": "incident-sources",
            "operation": "listSourceReports",
            "output": {
              "kind": "jsonata",
              "expr": "response.sources"
            }
          }
        ],
        "compute": [
          {
            "id": "source-options",
            "expression": "$exists(sources.`analysis-selection.source`) ? sources.`analysis-selection.source`.{'value':id,'label':label} : []",
            "assign": "incident.sourceOptions",
            "dependencies": [
              "sources.analysis-selection.source"
            ]
          },
          {
            "id": "selected-model",
            "expression": "'semantic'",
            "assign": "model"
          }
        ],
        "outputs": [
          {
            "token": "selected-report",
            "from": "inputs.selection.sourceReport",
            "when": "$exists(inputs.selection) and $length(inputs.selection.sourceReport) > 0"
          },
          {
            "token": "selected-model",
            "from": "computed.model"
          }
        ],
        "behavior": {
          "on": {
            "save": [
              {
                "do": "assign",
                "target": "incident.selection",
                "args": {
                  "from": "$event.values"
                }
              }
            ]
          }
        },
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:selection",
            "region": "shell",
            "props": {
              "saveLabel": "Select report",
              "discardLabel": "Discard",
              "initiallyDirty": true
            },
            "before": [
              {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Loading incident reports",
                  "size": "medium"
                },
                "visibility": "systemInputs.numSourcesRunning > 0"
              }
            ],
            "bindings": {
              "fields": {
                "expression": "{'properties':{'sourceReport':{'title':'Source report','type':'string','options':incident.sourceOptions,'placeholder':'Choose a source report','span':12}},'required':['sourceReport']}"
              },
              "value": {
                "from": "incident.selection"
              }
            },
            "visibility": "$count(incident.sourceOptions) > 0"
          }
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "report-analysis": {
        "id": "report-analysis",
        "systemInputs": [
          "numSourcesRunning"
        ],
        "inputs": [
          {
            "token": "selected-report",
            "as": "selectedReport",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "selected-report-content",
            "as": "reportContent",
            "required": true
          },
          {
            "token": "saved-report-lookup-envelope",
            "as": "savedReportEnvelope",
            "required": true
          },
          {
            "token": "incident.analysisRequest",
            "as": "analysisRequest"
          }
        ],
        "sources": [
          {
            "id": "report-analysis.source",
            "service": "incident-report-analysis",
            "operation": "analyzeReportBlueprint",
            "when": "inputs.analysisRequest.selectedReport = inputs.selectedReport and inputs.analysisRequest.selectedModel = inputs.selectedModel",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.reportContent,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          }
        ],
        "compute": [
          {
            "id": "analysis-report",
            "expression": "sources.`report-analysis.source`",
            "assign": "analysisReport",
            "dependencies": [
              "sources.report-analysis.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "analysis-report-blueprint",
            "from": "computed.analysisReport",
            "when": "computed.analysisReport != null"
          }
        ],
        "behavior": {
          "on": {
            "press": [
              {
                "do": "assign",
                "target": "incident.analysisRequest",
                "args": {
                  "from": "{'selectedReport':inputs.selectedReport,'selectedModel':inputs.selectedModel,'requestedAt':$now()}"
                }
              }
            ]
          }
        },
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:request",
            "region": "shell",
            "props": {
              "label": "Analyze / refresh report",
              "appearance": "primary"
            },
            "before": [
              {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Analyzing report",
                  "size": "medium"
                },
                "visibility": "systemInputs.numSourcesRunning > 0"
              }
            ]
          }
        },
        "events": {
          "press": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "analysis-context": {
        "id": "analysis-context",
        "inputs": [
          {
            "token": "selected-report",
            "as": "selectedReport",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "analysis-context.source-report",
            "service": "incident-sources",
            "operation": "getSourceReport",
            "when": "$length(inputs.selectedReport) > 0",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedReport}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          },
          {
            "id": "analysis-context.saved-report",
            "service": "incident-saved-reports",
            "operation": "getSavedReport",
            "when": "$length(inputs.selectedReport) > 0 and $length(inputs.selectedModel) > 0",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedReport,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'found':response != null,'analysisReport':response ? response.analysisReport : null,'asOn':response ? response.asOn : null}"
            }
          }
        ],
        "compute": [
          {
            "id": "selected-source-content",
            "expression": "$exists(sources.`analysis-context.source-report`) ? sources.`analysis-context.source-report`.content : ''",
            "assign": "incidentReport",
            "dependencies": [
              "sources.analysis-context.source-report"
            ]
          },
          {
            "id": "saved-report-result",
            "expression": "sources.`analysis-context.saved-report`",
            "assign": "savedReportResult",
            "dependencies": [
              "sources.analysis-context.saved-report"
            ]
          }
        ],
        "outputs": [
          {
            "token": "selected-report-content",
            "from": "computed.incidentReport",
            "when": "$length(computed.incidentReport) > 0"
          },
          {
            "token": "saved-report-lookup-envelope",
            "from": "computed.savedReportResult"
          }
        ]
      },
      "report-resolution": {
        "id": "report-resolution",
        "inputs": [
          {
            "token": "selected-report",
            "as": "selectedReport",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "saved-report-lookup-envelope",
            "as": "savedReportEnvelope",
            "required": true
          },
          {
            "token": "analysis-report-blueprint",
            "as": "analysisReport",
            "required": false
          }
        ],
        "sources": [
          {
            "id": "report-resolution.source",
            "service": "incident-saved-reports",
            "operation": "putSavedReport",
            "when": "inputs.analysisReport != null",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedReport,'model':inputs.selectedModel,'analysis_report':inputs.analysisReport}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          }
        ],
        "compute": [
          {
            "id": "resolved-saved-report-envelope",
            "expression": "$exists(sources.`report-resolution.source`) and sources.`report-resolution.source` != null ? {'found':true,'analysisReport':sources.`report-resolution.source`.analysisReport,'asOn':sources.`report-resolution.source`.asOn} : inputs.savedReportEnvelope",
            "assign": "incident.resolvedSavedReportEnvelope",
            "dependencies": [
              "inputs.savedReportEnvelope",
              "sources.report-resolution.source"
            ]
          }
        ],
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:report",
            "region": "shell",
            "visibility": "incident.resolvedSavedReportEnvelope.found and incident.resolvedSavedReportEnvelope.analysisReport != null",
            "bindings": {
              "blueprint": {
                "expression": "incident.resolvedSavedReportEnvelope.analysisReport"
              }
            },
            "before": [
              {
                "capability": "primitive:datetime",
                "props": {
                  "label": "Analysis as of"
                },
                "bindings": {
                  "value": {
                    "expression": "incident.resolvedSavedReportEnvelope.asOn"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "presentation": {
      "slots": [
        "shell"
      ],
      "root": "shell",
      "layout": {
        "shell": {
          "direction": "column",
          "gap": "l"
        }
      },
      "allowedCapabilities": [
        {
          "tier": "incident-analysis"
        },
        "fluent:button",
        "fluent:spinner",
        "gik:blueprint",
        "primitive:datetime",
        "primitive:form"
      ]
    },
    "metadata": {
      "compositionPattern": "external-model-selected-analysis-with-nested-report"
    }
  }
}
