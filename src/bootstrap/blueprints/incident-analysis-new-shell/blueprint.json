{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-analysis-new-shell",
    "kind": "incident-analysis-shell",
    "version": "1.0.0",
    "structureMode": "fixed",
    "serviceTiers": [
      {
        "id": "incident-analysis",
        "kind": "incident-analysis"
      },
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [
      {
        "id": "incident-analysis-to-runtime",
        "from": "incident-analysis",
        "to": "runtime-document",
        "implementationPrograms": [
          {
            "id": "reactive",
            "when": "true"
          }
        ],
        "fallback": "reactive"
      }
    ],
    "projectionTiers": [
      {
        "id": "incident-analysis",
        "kind": "incident-analysis",
        "capabilities": [
          "incident-analysis:selection",
          "incident-analysis:source-content",
          "incident-analysis:request",
          "incident-analysis:report"
        ]
      },
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [
      {
        "id": "incident-analysis-to-runtime",
        "from": "incident-analysis",
        "to": "runtime-document",
        "representations": [
          {
            "id": "shared-shell",
            "views": {
              "analysis-params": {
                "primary": {
                  "capability": "primitive:form",
                  "region": "params-form",
                  "props": {
                    "saveLabel": "Select source",
                    "discardLabel": "Discard",
                    "initiallyDirty": true
                  },
                  "before": [
                    {
                      "capability": "fluent:spinner",
                      "props": {
                        "label": "Loading incident reports",
                        "size": "medium"
                      },
                      "visibility": "systemInputs.numSourcesRunning > 0"
                    }
                  ],
                  "bindings": {
                    "fields": {
                      "expression": "{'properties':{'source':{'title':'Source report','type':'string','options':incident.sourceOptions,'placeholder':'Choose a source report','span':12},'model':{'title':'Analysis model','type':'string','options':[{'value':'semantic','label':'Semantic'},{'value':'source-faithful','label':'Source faithful'},{'value':'refinement','label':'Refinement'}],'span':12}},'required':['source','model']}"
                    },
                    "value": {
                      "from": "incident.selection"
                    }
                  }
                }
              },
              "cache-envelope-retrieve": {
                "primary": {
                  "capability": "fluent:button",
                  "region": "analyze-button",
                  "props": {
                    "label": "Analyze / refresh report",
                    "appearance": "primary"
                  }
                }
              },
              "source-retrieve": {
                "primary": {
                  "capability": "primitive:markdown",
                  "region": "source-content",
                  "bindings": {
                    "value": {
                      "from": "selectedSourceContent"
                    }
                  }
                }
              },
              "incident-analysis": {
                "primary": {
                  "capability": "fluent:spinner",
                  "region": "analysis-report",
                  "props": {
                    "label": "Analyzing report",
                    "size": "medium"
                  },
                  "visibility": "systemInputs.numSourcesRunning > 0"
                }
              },
              "report-viewer": {
                "primary": {
                  "capability": "gik:blueprint",
                  "region": "analysis-report",
                  "visibility": "incident.savedReportEnvelope.found and incident.savedReportEnvelope.analysisReport != null",
                  "bindings": {
                    "blueprint": {
                      "expression": "incident.savedReportEnvelope.analysisReport"
                    },
                    "instanceKey": {
                      "expression": "incident.savedReportEnvelope.asOnStamp"
                    }
                  },
                  "before": [
                    {
                      "capability": "fluent:text",
                      "props": {
                        "value": "No analysis report available.",
                        "block": true
                      },
                      "visibility": "incident.savedReportEnvelope = null"
                    },
                    {
                      "capability": "primitive:datetime",
                      "props": {
                        "label": "Analysis as of"
                      },
                      "bindings": {
                        "value": {
                          "expression": "incident.savedReportEnvelope.asOn"
                        }
                      },
                      "visibility": "incident.savedReportEnvelope.asOn != null"
                    }
                  ]
                }
              }
            }
          }
        ],
        "fallback": "shared-shell"
      }
    ],
    "services": {
      "incident-sources": {
        "blueprint": {
          "$ref": "blueprint:incident-analysis-assets@1.0.0"
        },
        "version": "1",
        "operations": {
          "listSourceReports": {
            "operation": "list-sources",
            "contract": "incident-source-list/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "getSourceReport": {
            "operation": "get-source",
            "contract": "incident-source/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'sourceId':input.source_report_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-saved-reports": {
        "blueprint": {
          "$ref": "blueprint:incident-analysis-assets@1.0.0"
        },
        "version": "1",
        "operations": {
          "getSavedReport": {
            "operation": "get-asset",
            "contract": "saved-report-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':input.source_report_key,'analysis_key':input.model}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "putSavedReport": {
            "operation": "put-asset",
            "contract": "saved-report-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':input.source_report_key,'analysis_key':input.model,'saved_report_envelope':{'asOn':input.as_on,'asOnStamp':input.as_on_stamp,'analysisReport':input.analysis_response}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-report-analysis": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReportBlueprint": {
            "operation": "chat",
            "contract": "incident-report-blueprint/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "($mode := input.model; $guidance := $mode = 'refinement' ? 'Preserve every source section, fact, identifier, value, relationship, order, and uncertainty while improving report organization and clarity.' : ($mode = 'source-faithful' ? 'Preserve only facts, relationships, verdicts, impacts, priorities, actions, ordering, identifiers, evidence, and uncertainty explicitly asserted by the source. Do not infer causality, compromise status, severity, urgency, attribution, or recommendations.' : 'Normalize the supplied incident facts, relationships, evidence, uncertainty, impacts, and actions without inventing content.'); {'message':'Write the incident analysis report from this source report:\\n\\n' & input.incident_report,'instructions':$guidance & ' Return only one JSON object containing the complete report Markdown in the markdown property. Do not construct a Blueprint, service, projection, Cell, or presentation.','agentName':$mode = 'refinement' ? 'Incident-Report-Refinement-Agent' : 'Incident-Report-Semantic-Agent','maxOutputTokens':8000})"
              }
            },
            "response": {
              "transform": {
                "kind": "jsonata",
                "expr": "($markdown := $type(response.markdown) = 'string' ? response.markdown : response.payload.runtime.state.report.markdown; {'gik':'0.1','type':'blueprint','payload':{'id':'generated-incident-report','kind':'semantic-report','version':'1.0.0','structureMode':'fixed','serviceTiers':[{'id':'runtime-document','kind':'runtime-document'}],'serviceRecipes':[],'projectionTiers':[{'id':'report-semantic','kind':'incident-report-semantic-model','capabilities':[]},{'id':'runtime-document','kind':'runtime-document','capabilities':[]}],'projectionRecipes':[{'id':'semantic-report-to-runtime','from':'report-semantic','to':'runtime-document','representations':[{'id':'report','views':{'report':{'primary':{'capability':'primitive:markdown','bindings':{'value':{'from':'report.markdown'}},'region':'report'}}},'presentation':{'slots':['report'],'root':'report'}}],'fallback':'report'}],'runtime':{'externals':{'projectionViews':{'primitive':{'from':'primitive','use':['markdown']}}},'state':{'report':{'markdown':$markdown}}},'cells':{'report':{'id':'report'}},'presentation':{'slots':['report'],'root':'report','allowedCapabilities':['primitive:markdown']}}})"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            },
            "onViolation": {
              "action": "correction-prompt",
              "maxAttempts": 2
            }
          }
        },
        "config": {
          "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
          "credentialRef": "foundry-agent/access-key",
          "responseMode": "json"
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": [
              "button",
              "spinner",
              "text"
            ]
          },
          "primitive": {
            "from": "primitive",
            "use": [
              "form",
              "datetime",
              "markdown"
            ]
          }
        }
      },
      "state": {
        "incident": {
          "selection": {
            "source": "",
            "model": "semantic"
          },
          "sourceOptions": [],
          "refresherStamp": null,
          "savedReportEnvelope": null
        }
      }
    },
    "cells": {
      "analysis-params": {
        "id": "analysis-params",
        "systemInputs": [
          "numSourcesRunning"
        ],
        "sources": [
          {
            "id": "analysis-params.source",
            "service": "incident-sources",
            "operation": "listSourceReports",
            "when": "true",
            "output": {
              "kind": "jsonata",
              "expr": "response.sources"
            }
          }
        ],
        "compute": [
          {
            "id": "source-options",
            "expression": "$exists(sources.`analysis-params.source`) ? sources.`analysis-params.source`.{'value':id,'label':label} : []",
            "assign": "incident.sourceOptions",
            "dependencies": [
              "sources.analysis-params.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "selected-source",
            "from": "incident.selection.source"
          },
          {
            "token": "selected-model",
            "from": "incident.selection.model"
          }
        ],
        "behavior": {
          "on": {
            "save": [
              {
                "do": "assign",
                "target": "incident.selection",
                "args": {
                  "from": "$event.values"
                }
              },
              {
                "do": "assign",
                "target": "incident.refresherStamp",
                "args": {
                  "value": null
                }
              }
            ]
          }
        },
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:selection",
            "region": "params-form",
            "props": {
              "saveLabel": "Select source",
              "discardLabel": "Discard",
              "initiallyDirty": true
            },
            "before": [
              {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Loading incident reports",
                  "size": "medium"
                },
                "visibility": "systemInputs.numSourcesRunning > 0"
              }
            ],
            "bindings": {
              "fields": {
                "expression": "{'properties':{'source':{'title':'Source report','type':'string','options':incident.sourceOptions,'placeholder':'Choose a source report','span':12},'model':{'title':'Analysis model','type':'string','options':[{'value':'semantic','label':'Semantic'},{'value':'source-faithful','label':'Source faithful'},{'value':'refinement','label':'Refinement'}],'span':12}},'required':['source','model']}"
              },
              "value": {
                "from": "incident.selection"
              }
            }
          }
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "source-retrieve": {
        "id": "source-retrieve",
        "inputs": [
          {
            "token": "selected-source",
            "as": "selectedSource",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "source-retrieve.source",
            "service": "incident-sources",
            "operation": "getSourceReport",
            "when": "$type(inputs.selectedSource) = 'string' and inputs.selectedSource != ''",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedSource}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response.content"
            }
          }
        ],
        "compute": [
          {
            "id": "selected-source-content",
            "expression": "sources.`source-retrieve.source`",
            "assign": "selectedSourceContent",
            "dependencies": [
              "sources.source-retrieve.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "selected-source-content",
            "from": "computed.selectedSourceContent",
            "when": "$type(computed.selectedSourceContent) = 'string' and computed.selectedSourceContent != ''"
          }
        ],
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:source-content",
            "region": "source-content",
            "bindings": {
              "value": {
                "from": "selectedSourceContent"
              }
            }
          }
        }
      },
      "cache-envelope-retrieve": {
        "id": "cache-envelope-retrieve",
        "inputs": [
          {
            "token": "selected-source",
            "as": "selectedSource",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "incident.refresherStamp",
            "as": "refresherStamp"
          }
        ],
        "sources": [
          {
            "id": "cache-envelope-retrieve.source",
            "service": "incident-saved-reports",
            "operation": "getSavedReport",
            "when": "$type(inputs.selectedSource) = 'string' and inputs.selectedSource != '' and $type(inputs.selectedModel) = 'string' and inputs.selectedModel != ''",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedSource,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'found':response != null,'analysisReport':response ? response.analysisReport : null,'asOn':response ? response.asOn : null,'asOnStamp':response ? response.asOnStamp : null}"
            }
          }
        ],
        "compute": [
          {
            "id": "saved-report-envelope",
            "expression": "sources.`cache-envelope-retrieve.source`",
            "assign": "savedReportEnvelope",
            "dependencies": [
              "sources.cache-envelope-retrieve.source"
            ]
          },
          {
            "id": "saved-refresher-stamp",
            "expression": "inputs.refresherStamp != null ? inputs.refresherStamp : sources.`cache-envelope-retrieve.source`.asOnStamp",
            "assign": "savedRefresherStamp",
            "dependencies": [
              "inputs.refresherStamp",
              "sources.cache-envelope-retrieve.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "saved-report-envelope",
            "from": "computed.savedReportEnvelope"
          },
          {
            "token": "saved-refresher-stamp",
            "from": "computed.savedRefresherStamp",
            "when": "computed.savedRefresherStamp != null"
          }
        ],
        "behavior": {
          "on": {
            "press": [
              {
                "do": "assign",
                "target": "incident.refresherStamp",
                "args": {
                  "from": "$now()"
                }
              }
            ]
          }
        },
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:request",
            "region": "analyze-button",
            "props": {
              "label": "Analyze / refresh report",
              "appearance": "primary"
            }
          }
        },
        "events": {
          "press": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "incident-analysis": {
        "id": "incident-analysis",
        "systemInputs": [
          "numSourcesRunning"
        ],
        "inputs": [
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "selected-source-content",
            "as": "selectedSourceContent",
            "required": true
          },
          {
            "token": "saved-refresher-stamp",
            "as": "savedRefresherStamp",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "incident-analysis.source",
            "service": "incident-report-analysis",
            "operation": "analyzeReportBlueprint",
            "when": "inputs.savedRefresherStamp != null and inputs.selectedModel != 'refinement'",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.selectedSourceContent,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'analysisResponse':response,'asOn':$now()}"
            },
            "acceptanceCriteria": [
              {
                "kind": "blueprint",
                "code": "incident-report-blueprint",
                "message": "Incident analysis source did not produce a valid Blueprint"
              },
              {
                "kind": "jsonata",
                "expr": "$type(data.payload.runtime.state.report.markdown) = 'string' and $length(data.payload.runtime.state.report.markdown) > 0",
                "code": "incident-report-markdown",
                "message": "Incident analysis source produced an empty report"
              }
            ]
          },
          {
            "id": "incident-analysis.refinement-source",
            "service": "incident-report-analysis",
            "operation": "analyzeReportBlueprint",
            "when": "inputs.savedRefresherStamp != null and inputs.selectedModel = 'refinement'",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.selectedSourceContent,'model':inputs.selectedModel}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'analysisResponse':response,'asOn':$now()}"
            },
            "acceptanceCriteria": [
              {
                "kind": "blueprint",
                "code": "incident-report-blueprint",
                "message": "Incident analysis source did not produce a valid Blueprint"
              },
              {
                "kind": "jsonata",
                "expr": "$type(data.payload.runtime.state.report.markdown) = 'string' and $length(data.payload.runtime.state.report.markdown) > 0",
                "code": "incident-report-markdown",
                "message": "Incident analysis source produced an empty report"
              }
            ]
          }
        ],
        "compute": [
          {
            "id": "analysis-result",
            "expression": "$exists(sources.`incident-analysis.refinement-source`) ? sources.`incident-analysis.refinement-source` : sources.`incident-analysis.source`",
            "assign": "analysisResult",
            "dependencies": [
              "sources.incident-analysis.source",
              "sources.incident-analysis.refinement-source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "analysis-response",
            "from": "computed.analysisResult.analysisResponse",
            "when": "computed.analysisResult.analysisResponse != null"
          },
          {
            "token": "asOn",
            "from": "computed.analysisResult.asOn",
            "when": "computed.analysisResult.asOn != null"
          },
          {
            "token": "asOnStamp",
            "from": "inputs.savedRefresherStamp",
            "when": "computed.analysisResult.analysisResponse != null and inputs.savedRefresherStamp != null"
          }
        ],
        "potentialViews": {
          "primary": {
            "capability": "fluent:spinner",
            "region": "analysis-report",
            "props": {
              "label": "Analyzing report",
              "size": "medium"
            },
            "visibility": "systemInputs.numSourcesRunning > 0"
          }
        }
      },
      "cache-envelope-update": {
        "id": "cache-envelope-update",
        "inputs": [
          {
            "token": "selected-source",
            "as": "selectedSource",
            "required": true
          },
          {
            "token": "selected-model",
            "as": "selectedModel",
            "required": true
          },
          {
            "token": "analysis-response",
            "as": "analysisResponse",
            "required": true
          },
          {
            "token": "asOn",
            "as": "asOn",
            "required": true
          },
          {
            "token": "asOnStamp",
            "as": "asOnStamp",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "cache-envelope-update.source",
            "service": "incident-saved-reports",
            "operation": "putSavedReport",
            "when": "inputs.analysisResponse != null and inputs.asOn != null and inputs.asOnStamp != null",
            "input": {
              "kind": "jsonata",
              "expr": "{'source_report_key':inputs.selectedSource,'model':inputs.selectedModel,'analysis_response':inputs.analysisResponse,'as_on':inputs.asOn,'as_on_stamp':inputs.asOnStamp}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "{'found':response != null,'analysisReport':response ? response.analysisReport : null,'asOn':response ? response.asOn : null,'asOnStamp':response ? response.asOnStamp : null}"
            }
          }
        ],
        "compute": [
          {
            "id": "saved-report-envelope",
            "expression": "sources.`cache-envelope-update.source`",
            "assign": "savedReportEnvelope",
            "dependencies": [
              "sources.cache-envelope-update.source"
            ]
          }
        ],
        "outputs": [
          {
            "token": "saved-report-envelope",
            "from": "computed.savedReportEnvelope",
            "when": "computed.savedReportEnvelope != null"
          }
        ]
      },
      "report-viewer": {
        "id": "report-viewer",
        "inputs": [
          {
            "token": "saved-report-envelope",
            "as": "savedReportEnvelope"
          }
        ],
        "compute": [
          {
            "id": "saved-report-envelope",
            "expression": "inputs.savedReportEnvelope",
            "assign": "incident.savedReportEnvelope",
            "dependencies": [
              "inputs.savedReportEnvelope"
            ]
          }
        ],
        "potentialViews": {
          "primary": {
            "capability": "incident-analysis:report",
            "region": "analysis-report",
            "visibility": "incident.savedReportEnvelope.found and incident.savedReportEnvelope.analysisReport != null",
            "bindings": {
              "blueprint": {
                "expression": "incident.savedReportEnvelope.analysisReport"
              },
              "instanceKey": {
                "expression": "incident.savedReportEnvelope.asOnStamp"
              }
            },
            "before": [
              {
                "capability": "fluent:text",
                "props": {
                  "value": "No analysis report available.",
                  "block": true
                },
                "visibility": "incident.savedReportEnvelope = null"
              },
              {
                "capability": "primitive:datetime",
                "props": {
                  "label": "Analysis as of"
                },
                "bindings": {
                  "value": {
                    "expression": "incident.savedReportEnvelope.asOn"
                  }
                },
                "visibility": "incident.savedReportEnvelope.asOn != null"
              }
            ]
          }
        }
      }
    },
    "presentation": {
      "slots": [
        "shell",
        {
          "id": "params-form",
          "region": "shell"
        },
        {
          "id": "analyze-button",
          "region": "shell"
        },
        {
          "id": "content",
          "region": "shell"
        },
        {
          "id": "source-content",
          "region": "content"
        },
        {
          "id": "analysis-report",
          "region": "content"
        }
      ],
      "root": "shell",
      "layout": {
        "shell": {
          "direction": "column",
          "gap": "l"
        },
        "content": {
          "gap": "l",
          "align": "stretch"
        },
        "source-content": {
          "direction": "column",
          "gap": "m"
        },
