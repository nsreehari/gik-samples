{
  "format": "gik-scenarios/1",
  "blueprint": "incident-analysis-new-shell",
  "contextPresets": {
    "fixed-presentation": {
      "label": "Fixed presentation",
      "context": { "model": "fixed-presentation" }
    },
    "agent-generated-presentation": {
      "label": "Agent-generated presentation",
      "context": { "model": "agent-generated-presentation" }
    }
  },
  "scenarios": [
    {
      "id": "scenario-1a",
      "title": "Password spray with fixed presentation",
      "description": "Analyzes the password-spray and mailbox-compromise incident using fixed presentation.",
      "contextPreset": "fixed-presentation",
      "applicableContexts": ["fixed-presentation"],
      "resetAtStart": true,
      "steps": [{
        "id": "request-analysis",
        "title": "Analyze with fixed presentation",
        "acts": [
          { "id": "select-source-and-model", "title": "Select password spray and fixed presentation", "event": { "node": "analysis-params--primary--in-params-form", "name": "save", "payload": { "values": { "source": "password-spray-mailbox", "model": "fixed-presentation" } } } },
          { "id": "refresh-analysis", "title": "Analyze the selected incident", "event": { "node": "incident-analysis--request--in-analysis-report", "name": "press", "payload": {} } },
          { "id": "wait-for-source-response", "title": "Wait for the fixed-presentation response", "wait": { "when": "$exists($state.blueprintRunState.cells.`incident-analysis`.sourceValues.`incident-analysis.fixed-presentation-source`.analysisResponse)" } },
          { "id": "observe-generated-report", "title": "Verify the report identifier and presentation", "observe": { "select": {
            "containsIncidentId": "$contains($string($state.blueprintRunState.cells.`incident-analysis`.sourceValues.`incident-analysis.fixed-presentation-source`.analysisResponse), '68b54272-f60b-53fa-b3d4-2494c7bd598d')",
            "hasPresentation": "$count($state.blueprintRunState.cells.`incident-analysis`.sourceValues.`incident-analysis.fixed-presentation-source`.analysisResponse.payload.presentation.slots) > 0"
          } } }
        ]
      }]
    },
