{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "portfolio-intelligence-assets",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "events": [
        "get-report",
        "put-report"
      ],
      "outputs": {
        "result": {
          "from": "portfolioAssets.result",
          "description": "Result of the most recently completed portfolio report operation."
        }
      }
    },
    "serviceTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [],
    "projectionTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [],
    "runtime": {
      "state": {
        "portfolioAssets": {
          "result": null
        }
      }
    },
    "cells": {
      "asset-controller": {
        "id": "asset-controller",
        "behavior": {
          "on": {
            "get-report": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readSavedReport"
                }
              }
            ],
            "put-report": [
              {
                "do": "invoke",
                "control": {
                  "tool": "writeSavedReport"
                }
              }
            ]
          }
        },
        "events": {
          "get-report": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "put-report": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "services": {
      "storage": {
        "kind": "durable-storage",
        "version": "1",
        "operations": {
          "readSavedReport": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'portfolio-report:' & effect.data.portfolio_key & '/' & effect.data.analysis_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'portfolioAssets.result','value':response}]}"
              }
            }
          },
          "writeSavedReport": {
            "operation": "write",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'portfolio-report:' & effect.data.portfolio_key & '/' & effect.data.analysis_key,'value':effect.data.saved_report_envelope}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'portfolioAssets.result','value':effect.data.saved_report_envelope}]}"
              }
            }
          }
        },
        "config": {
          "connection": "blueprint-state"
        },
        "scope": "per-blueprint"
      }
    }
  }
}
