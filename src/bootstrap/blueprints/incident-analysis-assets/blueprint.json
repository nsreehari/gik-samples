{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-analysis-assets",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "events": [
        "list-sources",
        "get-source",
        "list-assets",
        "get-asset",
        "put-asset",
        "delete-asset",
        "clear-assets"
      ],
      "outputs": {
        "result": {
          "from": "incidentAssets.result",
          "description": "Result of the most recently completed incident asset operation."
        }
      }
    },
    "serviceTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [],
    "projectionTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [],
    "runtime": {
      "state": {
        "incidentAssets": {
          "result": null,
          "runtimeAssetKeys": []
        }
      }
    },
    "cells": {
      "asset-controller": {
        "id": "asset-controller",
        "behavior": {
          "on": {
            "list-sources": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readSourceIndex"
                }
              }
            ],
            "get-source": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIncidentSource"
                }
              }
            ],
            "list-assets": [
              {
                "do": "invoke",
                "control": {
                  "tool": "listRuntimeAssets"
                }
              }
            ],
            "list-seed-assets": [
              {
                "do": "invoke",
                "control": {
                  "tool": "listSeedAssets"
                }
              }
            ],
            "get-asset": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readRuntimeAsset"
                }
              }
            ],
            "get-seed-asset": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readSeedAsset"
                }
              }
            ],
            "put-asset": [
              {
                "do": "invoke",
                "control": {
                  "tool": "writeIncidentAsset"
                }
              }
            ],
            "delete-asset": [
              {
                "do": "invoke",
                "control": {
                  "tool": "deleteIncidentAsset"
                }
              }
            ],
            "clear-assets": [
              {
                "do": "invoke",
                "control": {
                  "tool": "listAssetsToClear"
                }
              }
            ],
            "delete-storage-key": [
              {
                "do": "invoke",
                "control": {
                  "tool": "deleteStorageKey"
                }
              }
            ]
          }
        },
        "events": {
          "list-sources": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "get-source": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "list-assets": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "list-seed-assets": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "get-asset": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "get-seed-asset": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "put-asset": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "delete-asset": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "clear-assets": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "delete-storage-key": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "services": {
      "storage": {
        "kind": "durable-storage",
        "version": "1",
        "operations": {
          "readSourceIndex": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:sources'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'sources':response}}]}"
              }
            }
          },
          "readIncidentSource": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'source:' & effect.data.sourceId}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':response}]}"
              }
            }
          },
          "listRuntimeAssets": {
            "operation": "listKeys",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'prefix':'asset:' & effect.data.source_report_key & '/'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.runtimeAssetKeys','value':response}],'events':[{'node':'asset-controller','name':'list-seed-assets','payload':effect.data}]}"
              }
            }
          },
          "listSeedAssets": {
            "operation": "listKeys",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'prefix':'seed-asset:' & effect.data.source_report_key & '/'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($keys := $append(state.incidentAssets.runtimeAssetKeys, response); {'ops':[{'op':'set','path':'incidentAssets.result','value':{'assets':[$keys.($parts := $split($replace($,/^(seed-)?asset:/,''),'/'); {'source_report_key':$parts[0],'analysis_key':$join($parts[[1..$count($parts)-1]],'/')})]}}]})"
              }
            }
          },
          "readRuntimeAsset": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'asset:' & effect.data.source_report_key & '/' & effect.data.analysis_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response != null ? {'ops':[{'op':'set','path':'incidentAssets.result','value':response}]} : {'events':[{'node':'asset-controller','name':'get-seed-asset','payload':effect.data}]}"
              }
            }
          },
          "readSeedAsset": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'seed-asset:' & effect.data.source_report_key & '/' & effect.data.analysis_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':response}]}"
              }
            }
          },
          "writeIncidentAsset": {
            "operation": "write",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'asset:' & effect.data.source_report_key & '/' & effect.data.analysis_key,'value':effect.data.saved_report_envelope}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':effect.data.saved_report_envelope}]}"
              }
            }
          },
          "deleteIncidentAsset": {
            "operation": "delete",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'asset:' & effect.data.source_report_key & '/' & effect.data.analysis_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'deleted':true}}]}"
              }
            }
          },
          "listAssetsToClear": {
            "operation": "listKeys",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'prefix':'asset:'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'cleared':$count(response)}}],'events':[response.{'node':'asset-controller','name':'delete-storage-key','payload':{'key':$}}]}"
              }
            }
          },
          "deleteStorageKey": {
            "operation": "delete",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':effect.data.key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'outcome':'completed'}"
              }
            }
          }
        },
        "config": {
          "connection": "blueprint-state"
        },
        "scope": "per-blueprint"
      }
    },
    "metadata": {
      "scope": "backend",
      "executionMedium": "headless"
    }
  }
}
