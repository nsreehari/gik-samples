{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "blueprint-studio-crud",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "events": [
        "list-blueprints",
        "fetch-blueprint",
        "create-blueprint",
        "update-blueprint",
        "delete-blueprint",
        "create-draft",
        "create-blueprint-draft",
        "clone-blueprint-draft",
        "save-draft",
        "delete-draft",
        "promote-draft"
      ],
      "outputs": {
        "result": {
          "from": "studioCrud.result",
          "description": "Result of the most recently completed Blueprint Studio CRUD operation."
        }
      }
    },
    "serviceTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [],
    "projectionTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [],
    "runtime": {
      "state": {
        "studioCrud": {
          "result": null
        }
      }
    },
    "cells": {
      "crud-controller": {
        "id": "crud-controller",
        "behavior": {
          "on": {
            "list-blueprints": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprintIndex"
                }
              }
            ],
            "fetch-blueprint": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprint"
                }
              }
            ],
            "create-blueprint": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIndexForCreate"
                }
              }
            ],
            "update-blueprint": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIndexForUpdate"
                }
              }
            ],
            "delete-blueprint": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIndexForDelete"
                }
              }
            ],
            "create-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprintForCreateDraft"
                }
              }
            ],
            "create-blueprint-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIndexForCreateDraft"
                }
              }
            ],
            "clone-blueprint-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprintForCloneDraft"
                }
              }
            ],
            "save-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprintForSaveDraft"
                }
              }
            ],
            "delete-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprintForDeleteDraft"
                }
              }
            ],
            "read-index-for-delete-draft-entry": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIndexForDeleteDraftEntry"
                }
              }
            ],
            "promote-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readBlueprintForPromoteDraft"
                }
              }
            ],
            "read-index-for-promote-draft": [
              {
                "do": "invoke",
                "control": {
                  "tool": "readIndexForPromoteDraft"
                }
              }
            ],
            "write-blueprint-record": [
              {
                "do": "invoke",
                "control": {
                  "tool": "writeBlueprintRecord"
                }
              }
            ],
            "delete-blueprint-record": [
              {
                "do": "invoke",
                "control": {
                  "tool": "deleteBlueprintRecord"
                }
              }
            ],
            "write-blueprint-index": [
              {
                "do": "invoke",
                "control": {
                  "tool": "writeBlueprintIndex"
                }
              }
            ]
          }
        },
        "events": {
          "list-blueprints": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "fetch-blueprint": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "create-blueprint": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "update-blueprint": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "delete-blueprint": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "create-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "create-blueprint-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "clone-blueprint-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "save-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "delete-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "read-index-for-delete-draft-entry": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "promote-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "read-index-for-promote-draft": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "write-blueprint-record": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "delete-blueprint-record": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "write-blueprint-index": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "services": {
      "storage": {
        "kind": "durable-storage",
        "version": "1",
        "operations": {
          "readBlueprintIndex": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'studioCrud.result','value':{'blueprints':response ? response : [],'refresh':effect.data.refresh}}]}"
              }
            }
          },
          "readBlueprint": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'studioCrud.result','value':response}]}"
              }
            }
          },
          "readIndexForCreate": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($id := $trim(effect.data.id); $artifact := $merge([effect.data.blueprint, {'payload':$merge([effect.data.blueprint.payload, {'id':$id}])}]); $descriptor := {'id':$id,'label':$id,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'source':'user','readonly':false,'published':true}; $entry := $merge([$descriptor, {'artifact':$artifact,'ref':'blueprint:' & $id & '@' & $artifact.payload.version,'draft':null}]); $index := response ? response : []; $count($index[id = $id]) > 0 ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'created':false,'error':'Blueprint already exists','id':$id}}]} : {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$entry,'index':$append($index, $descriptor),'result':{'created':true,'blueprint':$entry}}}]})"
              }
            }
          },
          "readIndexForUpdate": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($id := $trim(effect.data.id); $index := response ? response : []; $current := $index[id = $id][0]; $artifact := $merge([effect.data.blueprint, {'payload':$merge([effect.data.blueprint.payload, {'id':$id}])}]); $descriptor := {'id':$id,'label':$id,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'source':'user','readonly':false,'published':true}; $entry := $merge([$descriptor, {'artifact':$artifact,'ref':'blueprint:' & $id & '@' & $artifact.payload.version,'draft':null}]); $not($exists($current)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'updated':false,'error':'Blueprint was not found','id':$id}}]} : $current.readonly ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'updated':false,'error':'Repository Blueprints are read-only','id':$id}}]} : {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$entry,'index':$index.($item := $; $item.id = $id ? $descriptor : $item),'result':{'updated':true,'blueprint':$entry}}}]})"
              }
            }
          },
          "readIndexForDelete": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($id := $trim(effect.data.id); $index := response ? response : []; $current := $index[id = $id][0]; $nextIndex := $index[id != $id]; $not($exists($current)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'deleted':false,'error':'Blueprint was not found','id':$id}}]} : $current.readonly ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'deleted':false,'error':'Repository Blueprints are read-only','id':$id}}]} : {'events':[{'node':'crud-controller','name':'delete-blueprint-record','payload':{'id':$id,'index':$nextIndex,'result':{'deleted':true,'id':$id,'blueprints':$nextIndex}}}]})"
              }
            }
          },
          "readBlueprintForCreateDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($entry := response; $id := $trim(effect.data.id); $draftId := $id & '.draft'; $artifact := $entry ? $merge([$entry.artifact, {'payload':$merge([$entry.artifact.payload, {'id':$draftId}])}]) : null; $draft := $artifact ? {'id':$draftId,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'ref':'blueprint:' & $draftId & '@' & $artifact.payload.version,'revision':1,'artifact':$artifact} : null; $not($exists($entry)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftCreated':false,'error':'Blueprint was not found','id':$id}}]} : $entry.readonly = true ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftCreated':false,'error':'Repository Blueprints are read-only; clone the Blueprint to edit it','id':$id}}]} : $entry.draft ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftCreated':false,'error':'Blueprint already has a draft','id':$id,'blueprint':$entry}}]} : {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$merge([$entry,{'draft':$draft}]),'result':{'draftCreated':true,'blueprint':$merge([$entry,{'draft':$draft}])}}}]})"
              }
            }
          },
          "readIndexForCreateDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($id := $trim(effect.data.id); $draftId := $id & '.draft'; $artifact := $merge([effect.data.blueprint, {'payload':$merge([effect.data.blueprint.payload, {'id':$draftId}])}]); $draft := {'id':$draftId,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'ref':'blueprint:' & $draftId & '@' & $artifact.payload.version,'revision':1,'artifact':$artifact}; $entry := {'id':$id,'label':$id,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'source':'user','readonly':false,'published':false,'artifact':null,'ref':null,'draft':$draft}; $descriptor := {'id':$id,'label':$id,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'source':'user','readonly':false,'published':false}; $index := response ? response : []; $nextIndex := $append($index,$descriptor); $count($index[id = $id]) > 0 ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftCreated':false,'error':'Blueprint already exists','id':$id}}]} : {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$entry,'index':$nextIndex,'result':{'draftCreated':true,'blueprint':$entry,'blueprints':$nextIndex}}}]})"
              }
            }
          },
          "readBlueprintForCloneDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.sourceId}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($source := response; $id := $trim(effect.data.id); $artifact := $source and $source.artifact != null ? $merge([$source.artifact, {'payload':$merge([$source.artifact.payload, {'id':$id,'kind':effect.data.kind,'version':effect.data.version}])}]) : null; $artifact = null ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftCreated':false,'error':'Clone source Blueprint was not found','id':effect.data.sourceId}}]} : {'events':[{'node':'crud-controller','name':'create-blueprint-draft','payload':{'id':$id,'blueprint':$artifact}}]})"
              }
            }
          },
          "readBlueprintForSaveDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.id}"
              },
              "validatorInput": {
                "kind": "jsonata",
                "expr": "effect.data.blueprint"
              },
              "validators": [
                {
                  "kind": "blueprint",
                  "code": "blueprint-draft-save",
                  "message": "The draft Blueprint is invalid"
                }
              ]
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($entry := response; $id := $trim(effect.data.id); $draftId := $id & '.draft'; $artifact := effect.data.blueprint; $draft := {'id':$draftId,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'ref':'blueprint:' & $draftId & '@' & $artifact.payload.version,'revision':($entry.draft.revision ? $entry.draft.revision + 1 : 1),'artifact':$artifact}; $not($exists($entry)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftSaved':false,'error':'Blueprint was not found','id':$id}}]} : $entry.readonly = true ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftSaved':false,'error':'Repository Blueprints are read-only','id':$id}}]} : $not($exists($entry.draft)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftSaved':false,'error':'Blueprint has no draft','id':$id}}]} : $artifact.payload.id != $draftId ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftSaved':false,'error':'Draft Blueprint ID does not match the selected Blueprint','id':$id}}]} : {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$merge([$entry,{'draft':$draft}]),'result':{'draftSaved':true,'blueprint':$merge([$entry,{'draft':$draft}])}}}]})"
              }
            }
          },
          "readBlueprintForDeleteDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($entry := response; $id := $trim(effect.data.id); $not($exists($entry)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftDeleted':false,'error':'Blueprint was not found','id':$id}}]} : $entry.readonly = true ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftDeleted':false,'error':'Repository Blueprints are read-only','id':$id}}]} : $not($exists($entry.draft)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'draftDeleted':false,'error':'Blueprint has no draft','id':$id,'blueprint':$entry}}]} : $entry.artifact = null ? {'events':[{'node':'crud-controller','name':'read-index-for-delete-draft-entry','payload':{'id':$id}}]} : {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$merge([$entry,{'draft':null}]),'result':{'draftDeleted':true,'blueprint':$merge([$entry,{'draft':null}])}}}]})"
              }
            }
          },
          "readIndexForDeleteDraftEntry": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($id := effect.data.id; $nextIndex := (response ? response : [])[id != $id]; {'events':[{'node':'crud-controller','name':'delete-blueprint-record','payload':{'id':$id,'index':$nextIndex,'result':{'draftDeleted':true,'deleted':true,'id':$id,'blueprints':$nextIndex}}}]})"
              }
            }
          },
          "readBlueprintForPromoteDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($entry := response; $id := $trim(effect.data.id); $not($exists($entry)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'promoted':false,'error':'Blueprint was not found','id':$id}}]} : $entry.readonly = true ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'promoted':false,'error':'Repository Blueprints are read-only','id':$id}}]} : $not($exists($entry.draft)) ? {'ops':[{'op':'set','path':'studioCrud.result','value':{'promoted':false,'error':'Blueprint has no draft','id':$id}}]} : {'events':[{'node':'crud-controller','name':'read-index-for-promote-draft','payload':{'entry':$entry}}]})"
              }
            }
          },
          "readIndexForPromoteDraft": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints'}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($entry := effect.data.entry; $id := $entry.id; $artifact := $merge([$entry.draft.artifact, {'payload':$merge([$entry.draft.artifact.payload, {'id':$id}])}]); $updated := $merge([$entry,{'version':$artifact.payload.version,'kind':$artifact.payload.kind,'source':'user','readonly':false,'published':true,'artifact':$artifact,'ref':'blueprint:' & $id & '@' & $artifact.payload.version,'draft':null}]); $descriptor := {'id':$id,'label':$entry.label,'version':$artifact.payload.version,'kind':$artifact.payload.kind,'source':'user','readonly':false,'published':true}; $index := (response ? response : []).($item := $; $item.id = $id ? $descriptor : $item); {'events':[{'node':'crud-controller','name':'write-blueprint-record','payload':{'entry':$updated,'index':$index,'result':{'promoted':true,'blueprint':$updated,'blueprints':$index}}}]})"
              }
            }
          },
          "writeBlueprintRecord": {
            "operation": "write",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.entry.id,'value':effect.data.entry}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "$exists(effect.data.index) ? {'events':[{'node':'crud-controller','name':'write-blueprint-index','payload':{'index':effect.data.index,'result':effect.data.result}}]} : {'ops':[{'op':'set','path':'studioCrud.result','value':effect.data.result}]}"
              }
            }
          },
          "deleteBlueprintRecord": {
            "operation": "delete",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'blueprint:' & effect.data.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'events':[{'node':'crud-controller','name':'write-blueprint-index','payload':{'index':effect.data.index,'result':effect.data.result}}]}"
              }
            }
          },
          "writeBlueprintIndex": {
            "operation": "write",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'index:blueprints','value':effect.data.index}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'studioCrud.result','value':effect.data.result}]}"
              }
            }
          }
        },
        "config": {
          "connection": "blueprint-state"
        },
        "scope": "per-blueprint"
      }
    },
    "metadata": {
      "scope": "backend",
      "executionMedium": "headless"
    }
  }
}
