{
  "format": "gik-scenarios/1",
  "blueprint": "portfolio-tracker-new",
  "contextPresets": {
    "simple-desktop": {
      "label": "Simple intelligence, desktop",
      "context": { "intelligence-model": "simple", "market-prices": "mock", "view": "desktop" }
    },
    "simple-mobile": {
      "label": "Simple intelligence, mobile",
      "context": { "intelligence-model": "simple", "market-prices": "mock", "view": "mobile" }
    },
    "mock-desktop": {
      "label": "Mock intelligence, desktop",
      "context": { "intelligence-model": "mock", "market-prices": "mock", "view": "desktop" }
    },
    "mock-mobile": {
      "label": "Mock intelligence, mobile",
      "context": { "intelligence-model": "mock", "market-prices": "mock", "view": "mobile" }
    },
    "semantic-desktop": {
      "label": "Semantic intelligence, desktop",
      "context": { "intelligence-model": "semantic", "market-prices": "mock", "view": "desktop" }
    },
    "semantic-mobile": {
      "label": "Semantic intelligence, mobile",
      "context": { "intelligence-model": "semantic", "market-prices": "mock", "view": "mobile" }
    },
    "live-market-desktop": {
      "label": "Simple intelligence, live market, desktop",
      "context": { "intelligence-model": "simple", "market-prices": "live", "view": "desktop", "ai": "foundry" }
    },
    "live-market-copilot-desktop": {
      "label": "Copilot intelligence, live market, desktop",
      "context": { "intelligence-model": "simple", "market-prices": "live", "view": "desktop", "ai": "copilot" }
    }
  },
  "scenarios": [
    {
      "id": "replace-holdings",
      "title": "Rebalance and observe a portfolio",
      "description": "Adds GOOG and AAPL, removes NVDA, increases the GOOG position, and observes each settled portfolio state.",
      "contextPreset": "mock-desktop",
      "applicableContexts": ["simple-desktop", "simple-mobile", "mock-desktop", "mock-mobile", "semantic-desktop", "semantic-mobile", "live-market-desktop", "live-market-copilot-desktop"],
      "resetAtStart": true,
      "steps": [
        {
          "id": "replace-positions",
          "title": "Add and value GOOG",
          "description": "Add GOOG and wait for its first settled valuation.",
          "acts": [
            {
              "id": "save-holdings",
              "title": "Add 10 shares of GOOG",
              "description": "Keep MSFT and NVDA, then add ten GOOG shares.",
              "event": {
                "node": "portfolio-holdings--primary--in-holdings",
                "name": "save",
                "payload": {
                  "rows": [
                    { "ticker": "MSFT", "quantity": 10, "costBasis": 400 },
                    { "ticker": "NVDA", "quantity": 4, "costBasis": 180 },
                    { "ticker": "GOOG", "quantity": 10, "costBasis": 150 }
                  ]
                }
              }
            },
            {
              "id": "wait-for-goog-price",
              "title": "Await GOOG price",
              "description": "Wait until market data returns the first GOOG quote.",
              "wait": {
                "when": "$exists($state.portfolio.stockQuotes.GOOG.price)"
              }
            },
            {
              "id": "wait-for-goog-valuation",
              "title": "Wait for GOOG valuation",
              "description": "Wait until portfolio value includes the new GOOG position.",
              "wait": {
                "when": "$exists($state.portfolio.value.positions.GOOG.value)"
              }
            },
            {
              "id": "observe-goog-valuation",
              "title": "Record GOOG valuation",
              "description": "Capture GOOG price, position value, and total market value.",
              "observe": {
                "select": {
                  "googQuote": "$state.portfolio.stockQuotes.GOOG.price",
                  "googPositionValue": "$state.portfolio.value.positions.GOOG.value",
                  "portfolioMarketValue": "$state.portfolio.value.summary.marketValue"
                }
              }
            }
          ]
        },
        {
          "id": "add-aapl",
          "title": "Add and value AAPL",
          "description": "Add AAPL and wait for its first settled valuation.",
          "acts": [
            {
              "id": "add-aapl-holding",
              "title": "Add 6 shares of AAPL",
              "description": "Add six AAPL shares while preserving every current position.",
              "event": {
                "node": "portfolio-holdings--primary--in-holdings",
                "name": "save",
                "payload": {
                  "rows": [
                    { "ticker": "MSFT", "quantity": 10, "costBasis": 400 },
                    { "ticker": "NVDA", "quantity": 4, "costBasis": 180 },
                    { "ticker": "GOOG", "quantity": 10, "costBasis": 150 },
                    { "ticker": "AAPL", "quantity": 6, "costBasis": 190 }
                  ]
                }
              }
            },
            {
              "id": "wait-for-aapl-price",
              "title": "Await AAPL price",
              "description": "Wait until market data returns the first AAPL quote.",
              "wait": {
                "when": "$exists($state.portfolio.stockQuotes.AAPL.price)"
              }
            },
            {
              "id": "wait-for-aapl-valuation",
              "title": "Wait for AAPL valuation",
              "description": "Wait until portfolio value includes all six AAPL shares.",
              "wait": {
                "when": "$state.portfolio.value.positions.AAPL.quantity = 6"
              }
            },
            {
              "id": "observe-aapl-valuation",
              "title": "Record AAPL valuation",
              "description": "Capture AAPL price, position value, and total market value.",
              "observe": {
                "select": {
                  "aaplQuote": "$state.portfolio.stockQuotes.AAPL.price",
                  "aaplPositionValue": "$state.portfolio.value.positions.AAPL.value",
                  "portfolioMarketValue": "$state.portfolio.value.summary.marketValue"
                }
              }
            }
          ]
        },
        {
          "id": "remove-nvda",
          "title": "Remove NVDA",
          "description": "Remove NVDA and confirm the portfolio settles without it.",
          "acts": [
            {
              "id": "remove-nvda-holding",
              "title": "Remove the NVDA position",
              "description": "Remove NVDA while preserving MSFT, GOOG, and AAPL.",
              "event": {
                "node": "portfolio-holdings--primary--in-holdings",
                "name": "save",
                "payload": {
                  "rows": [
                    { "ticker": "MSFT", "quantity": 10, "costBasis": 400 },
                    { "ticker": "GOOG", "quantity": 10, "costBasis": 150 },
                    { "ticker": "AAPL", "quantity": 6, "costBasis": 190 }
                  ]
                }
              }
            },
            {
              "id": "wait-for-nvda-removal",
              "title": "Wait for NVDA removal",
              "description": "Wait until NVDA disappears from the saved holdings.",
              "wait": {
                "when": "$not($exists($state.portfolio.holdings.NVDA))"
              }
            },
            {
              "id": "wait-for-revalued-portfolio",
              "title": "Await portfolio revalue",
              "description": "Wait until calculated positions no longer include NVDA.",
              "wait": {
                "when": "$not($exists($state.portfolio.value.positions.NVDA))"
              }
            },
            {
              "id": "observe-nvda-removal",
              "title": "Record NVDA removal",
              "description": "Capture removal confirmation and the new total market value.",
              "observe": {
                "select": {
                  "nvdaHoldingRemoved": "$not($exists($state.portfolio.holdings.NVDA))",
                  "nvdaValuationRemoved": "$not($exists($state.portfolio.value.positions.NVDA))",
                  "portfolioMarketValue": "$state.portfolio.value.summary.marketValue"
                }
              }
            }
          ]
        },
        {
          "id": "increase-goog",
          "title": "Increase and revalue GOOG",
          "description": "Increase GOOG quantity and confirm the position revalues.",
          "acts": [
            {
              "id": "increase-goog-holding",
              "title": "Increase GOOG to 15 shares",
              "description": "Increase GOOG to fifteen shares without changing other positions.",
              "event": {
                "node": "portfolio-holdings--primary--in-holdings",
                "name": "save",
                "payload": {
                  "rows": [
                    { "ticker": "MSFT", "quantity": 10, "costBasis": 400 },
                    { "ticker": "GOOG", "quantity": 15, "costBasis": 150 },
                    { "ticker": "AAPL", "quantity": 6, "costBasis": 190 }
                  ]
                }
              }
            },
            {
              "id": "wait-for-goog-quantity",
              "title": "Await GOOG edit",
              "description": "Wait until saved holdings contain fifteen GOOG shares.",
              "wait": {
                "when": "$state.portfolio.holdings.GOOG.quantity = 15"
              }
            },
            {
              "id": "wait-for-goog-revaluation",
              "title": "Wait for GOOG revaluation",
              "description": "Wait until calculated GOOG value reflects fifteen shares.",
              "wait": {
                "when": "$state.portfolio.value.positions.GOOG.quantity = 15"
              }
            },
            {
              "id": "observe-goog-revaluation",
              "title": "Record increased GOOG",
              "description": "Capture GOOG quantity, position value, and total market value.",
              "observe": {
                "select": {
                  "googQuantity": "$state.portfolio.value.positions.GOOG.quantity",
                  "googPositionValue": "$state.portfolio.value.positions.GOOG.value",
                  "portfolioMarketValue": "$state.portfolio.value.summary.marketValue"
                }
              }
            }
          ]
        },
        {
          "id": "review-intelligence",
          "title": "Review final portfolio intelligence",
          "description": "Wait for and record intelligence about the final portfolio.",
          "acts": [
            {
              "id": "wait-for-portfolio-intelligence",
              "title": "Wait for portfolio intelligence",
              "description": "Wait until the intelligence provider returns its final report.",
              "wait": {
                "when": "$trim($string($state.portfolio.intelligence.markdown)) != ''"
              }
            },
            {
              "id": "observe-goog-intelligence",
              "title": "Record portfolio intelligence",
              "description": "Capture the provider and report after the complete rebalance.",
              "observe": {
                "select": {
                  "provider": "$state.portfolio.intelligence.provider",
                  "report": "$state.portfolio.intelligence.markdown"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
