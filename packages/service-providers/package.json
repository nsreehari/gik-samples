{
  "name": "gik-service-providers",
  "version": "0.1.0",
  "description": "Individually imported host-managed scheduler and Gmail providers for GIK.",
  "type": "module",
  "license": "MIT",
  "author": "nsreehari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/gik-samples.git",
    "directory": "packages/service-providers"
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "examples"],
  "exports": {
    "./scheduler": { "types": "./dist/scheduler.d.ts", "import": "./dist/scheduler.js" },
    "./gmail": { "types": "./dist/gmail.d.ts", "import": "./dist/gmail.js" }
  },
  "dependencies": {
    "croner": "^9.1.0",
    "gik-controlface": ">=0.6.0",
    "gik-kernel": ">=0.4.1"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
