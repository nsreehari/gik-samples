{
  "name": "gik-samples-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Public local MCP companion for GIK Blueprint authoring, durable storage, Lore, Copilot, and provisioning.",
  "bin": {
    "gik-samples-mcp": "./src/index.js"
  },
  "scripts": {
    "verify:durable-runtime": "node scripts/vendor-gik-durable-runtime.mjs --verify",
    "vendor:durable-runtime": "node scripts/vendor-gik-durable-runtime.mjs",
    "provision:copilot": "node scripts/provision-copilot-agents.mjs",
    "start": "node src/index.js",
    "start:http": "node src/index.js --transport streamable-http",
    "start:stdio": "node src/index.js --transport stdio",
    "dry-run": "node src/index.js --dry-run --transport streamable-http",
    "test:smoke": "node scripts/smoke-registered-services.js",
    "test:filesystem": "node --test test/filesystem-storage.test.js test/filesystem-handler.test.js test/filesystem-mcp.test.js test/filesystem-snapshot-invalidations.test.js",
    "test:proxy": "node --test test/mcp-proxy.test.js",
    "test:copilot": "node --test test/copilot-cli.test.js test/provision-copilot-agents.test.js",
    "test:lore": "node --test test/lore.test.js",
    "foundry:provision": "node scripts/provision-foundry-agents.mjs",
    "test": "node scripts/vendor-gik-durable-runtime.mjs --verify && node scripts/smoke-registered-services.js && node --test test/*.test.js"
  },
  "dependencies": {
    "gik-agent-lifecycle-exp": "file:../../vendor/gik-packages/gik-agent-lifecycle-exp-0.1.1.tgz",
    "gik-durable-runtime": "file:vendor/gik-durable-runtime-0.8.1.tgz",
    "@modelcontextprotocol/sdk": "1.29.0",
    "chokidar": "4.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@azure/ai-projects": "^2.3.0",
    "@azure/identity": "^4.13.1"
  },
  "peerDependenciesMeta": {
    "@azure/ai-projects": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    ".env.template",
    "LICENSE",
    "README.md",
    "manifests",
    "registry.json",
    "scripts",
    "src",
    "vendor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
