# Copy this file to .env in this directory. The server and provisioning scripts
# load this one file. Existing process environment variables take precedence.

# Comma-separated registry service names to disable.
#DISABLE_HANDLERS=gik-agent-authoring

# Public address advertised by the manifests.
#GIK_MCP_SERVER_URL=http://127.0.0.1:7801/mcp

# Semicolon-separated id=absolute-path entries. Browser provisioning can only
# target these locally configured roots; plans never supply filesystem paths.
#GIK_WORKSPACE_ROOTS=workspace=C:\src\my-project;samples=C:\src\gik-samples

# Exact browser origins allowed to pair. Add your GitHub Pages origin when
# using the hosted Blueprint Studio. Wildcards are rejected.
#GIK_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Optional fixed one-use code for automation. When omitted, the server prints
# a random code at startup and rotates it after each successful pairing.
#GIK_PAIRING_CODE=
#GIK_PAIRING_TOKEN_TTL_MS=900000
#GIK_PROVISIONING_PLAN_TTL_MS=300000

# Mutable local data. Defaults stay under packages/mcp-server/.data.
#GIK_FILESYSTEM_STORAGE_ROOT=
#LORE_ROOT_DIR=

# Default directory used by trusted MCP Copilot tools.
#GIK_SAMPLES_WORKSPACE_ROOT=
#GIK_CAPABILITY_CATALOG=C:\src\my-project\.gik\capability-catalog.json
#GIK_MAX_ACTIVE_COPILOT_RUNS=2

# Standalone Copilot provisioning script. These are required only when the
# equivalent --plan and --target-dir arguments are omitted.
#COPILOT_PROVISIONING_PLAN=C:\path\to\copilot-project.json
#GIK_TARGET_WORKSPACE=C:\src\target-project

# Optional Azure/Foundry settings use local Azure CLI authentication. The
# non-secret project endpoint travels in the reviewed provisioning plan.
#AZURE_CLI_COMMAND=az

# Standalone Foundry provisioning script. Required only when --plan is omitted.
#FOUNDRY_PROVISIONING_PLAN=C:\path\to\foundry-project.json
