{
  "name": "gik-finbook-reference-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "reference-app-host/browser-host",
    "mcp-server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "npm run dev --workspace gik-finbook-browser-host",
    "dev:server": "npm run start --workspace gik-finbook-server",
    "validate": "tsx scripts/validate-blueprint.ts",
    "build": "npm run validate && npm run build --workspace gik-finbook-browser-host",
    "typecheck": "tsc -p reference-app-host/browser-host/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && npm run check --workspace gik-finbook-server",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.312",
    "@xyflow/react": "file:vendor/npm-packages/xyflow-react-12.11.1.tgz",
    "@xyflow/system": "file:vendor/npm-packages/xyflow-system-0.0.78.tgz",
    "gik-blueprint": ">=0.3.0",
    "gik-components": "file:../../packages/components",
    "gik-controlface": ">=0.3.0",
    "gik-durable-runtime": ">=0.9.0",
    "gik-evaluators": ">=0.2.0",
    "gik-kernel": ">=0.3.0",
    "gik-react": ">=0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@xyflow/react": "$@xyflow/react",
    "@xyflow/system": "$@xyflow/system"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
