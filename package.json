    "@gik/blueprint": "file:../gik-fresh/packages/blueprint",
    "@gik/blueprint-agent-host": "file:../gik-fresh/packages/blueprint-agent-host",
    "@gik/controlface": "file:../gik-fresh/packages/controlface",
    "@gik/durable-runtime": "file:../gik-fresh/packages/durable-runtime",
    "@gik/evaluators": "file:../gik-fresh/packages/evaluators",
    "@gik/kernel": "file:../gik-fresh/packages/kernel",
