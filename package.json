{
  "name": "gik-samples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/components"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "test": "vitest run --config vitest.config.ts",
    "test:app": "vitest run --config vitest.config.ts",
    "scenario:run": "node scripts/run-scenario.mjs",
    "agent:plan": "tsx scripts/generate-foundry-provisioning-plan.ts",
    "agent:plan:incident-analysis": "npm run agent:plan -- --manifest src/bootstrap/blueprints/incident-analysis-new-shell/agents/incident-report-fixed-presentation/provisioning.json --out .tmp/incident-report-fixed-presentation.foundry-plan.json",
    "agent:plan:incident-analysis-generated": "npm run agent:plan -- --manifest src/bootstrap/blueprints/incident-analysis-new-shell/agents/incident-report-agent-generated-presentation/provisioning.json --out .tmp/incident-report-agent-generated-presentation.foundry-plan.json",
    "test:pages": "node scripts/smoke-pages.mjs",
    "mcp:start": "node packages/mcp-server/src/index.js --transport streamable-http",
    "mcp:start:stdio": "node packages/mcp-server/src/index.js --transport stdio",
    "mcp:test": "node --test packages/mcp-server/test/*.test.js",
    "finbook:build": "npm run build --prefix apps/finbook",
    "finbook:dev": "npm run dev --prefix apps/finbook",
    "finbook:server": "npm run dev:server --prefix apps/finbook",
    "typecheck": "tsc -p packages/components/tsconfig.json --noEmit && tsc -p src/browser-host/tsconfig.json --noEmit && tsc -p src/headless/tsconfig.json --noEmit && tsc -p src/testing/tsconfig.json --noEmit && tsc -p storybook/tsconfig.json --noEmit && npm run typecheck --prefix apps/finbook",
    "validate:vendor": "node scripts/validate-vendored-packages.mjs",
    "vendor:gik": "node scripts/vendor-gik-packages.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.312",
    "gik-agent-lifecycle-exp": "file:vendor/gik-packages/gik-agent-lifecycle-exp-0.1.1.tgz",
    "gik-blueprint": "file:vendor/gik-packages/gik-blueprint-0.2.2.tgz",
    "gik-blueprint-agent-host": "file:vendor/gik-packages/gik-blueprint-agent-host-0.1.0.tgz",
    "gik-controlface": "file:vendor/gik-packages/gik-controlface-0.2.0.tgz",
    "gik-durable-runtime": "file:vendor/gik-packages/gik-durable-runtime-0.8.1.tgz",
    "gik-evaluators": "file:vendor/gik-packages/gik-evaluators-0.1.3.tgz",
    "gik-kernel": "file:vendor/gik-packages/gik-kernel-0.2.0.tgz",
    "gik-react": "file:vendor/gik-packages/gik-react-0.3.2.tgz",
    "@xyflow/react": "^12.11.2",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "gik-blueprint": "$gik-blueprint",
    "gik-controlface": "$gik-controlface",
    "gik-durable-runtime": "$gik-durable-runtime",
    "gik-evaluators": "$gik-evaluators",
    "gik-kernel": "$gik-kernel",
    "gik-react": "$gik-react"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "react-test-renderer": "^18.3.1",
    "rollup": "4.62.2",
    "sirv": "^3.0.2",
    "storybook": "10.5.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "4.1.10"
  }
}
