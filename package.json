    "@gik/react": "file:../gik-fresh/packages/react",
    "@gik/transport-http-sse": "file:../gik-fresh/packages/transport-http-sse",
    "@gik/transport-mcp-http": "file:../gik-fresh/packages/transport-mcp-http",
