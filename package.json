{
  "name": "gik-samples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/components",
    "packages/service-providers"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "test": "vitest run --config vitest.config.ts",
    "test:app": "vitest run --config vitest.config.ts",
    "test:distribution": "node --test scripts/test/*.test.mjs",
    "pages:collect-packages": "node scripts/collect-pages-packages.mjs",
    "scenario:run": "node scripts/run-scenario.mjs",
    "agent:plan": "tsx scripts/generate-foundry-provisioning-plan.ts",
    "agent:plan:incident-analysis": "npm run agent:plan -- --manifest src/bootstrap/blueprints/incident-analysis-new-shell/agents/incident-report-fixed-presentation/provisioning.json --out .tmp/incident-report-fixed-presentation.foundry-plan.json",
    "agent:plan:incident-analysis-generated": "npm run agent:plan -- --manifest src/bootstrap/blueprints/incident-analysis-new-shell/agents/incident-report-agent-generated-presentation/provisioning.json --out .tmp/incident-report-agent-generated-presentation.foundry-plan.json",
    "test:pages": "node scripts/smoke-pages.mjs",
    "mcp:start": "node packages/mcp-server/src/index.js --transport streamable-http",
    "mcp:start:stdio": "node packages/mcp-server/src/index.js --transport stdio",
    "mcp:test": "node --test packages/mcp-server/test/*.test.js",
    "finbook:build": "npm run build --prefix apps/finbook",
    "finbook:dev": "npm run dev --prefix apps/finbook",
    "finbook:server": "npm run dev:server --prefix apps/finbook",
    "typecheck:studio": "tsc -p packages/components/tsconfig.json --noEmit && npm run typecheck --workspace gik-service-providers && tsc -p src/browser-host/tsconfig.json --noEmit && tsc -p src/headless/tsconfig.json --noEmit && tsc -p src/testing/tsconfig.json --noEmit && tsc -p storybook/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:studio && npm run typecheck --prefix apps/finbook"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.312",
    "gik-agent-lifecycle-exp": ">=0.3.0",
    "gik-blueprint": ">=0.5.0",
    "gik-blueprint-agent-host": ">=0.2.1",
    "gik-components": "file:packages/components",
    "gik-controlface": ">=0.7.0",
    "gik-durable-runtime": ">=0.9.0",
    "gik-evaluators": ">=0.4.0",
    "gik-kernel": ">=0.4.1",
    "gik-react": ">=0.5.0",
    "gik-service-providers": "file:packages/service-providers",
    "@xyflow/react": "^12.11.2",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "gik-agent-lifecycle-exp": "$gik-agent-lifecycle-exp",
    "gik-blueprint": ">=0.5.0",
    "gik-blueprint-agent-host": "$gik-blueprint-agent-host",
    "gik-controlface": ">=0.7.0",
    "gik-durable-runtime": ">=0.9.0",
    "gik-evaluators": ">=0.4.0",
    "gik-kernel": ">=0.4.1",
    "gik-react": ">=0.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "react-test-renderer": "^18.3.1",
    "rollup": "4.62.2",
    "sirv": "^3.0.2",
    "storybook": "10.6.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "4.1.10"
  }
}
